config global 'main'
	option enabled '0'
	option engine 'none'
	option log_level 'notice'
	option listen '127.0.0.1'
	option listen_port '7890'

config routing 'routing'
	option china_policy 'direct'
	option proxy_policy 'proxy'
	option fail_closed '1'
	# Domestic rule sets are downloaded once by `config generate` and then
	# referenced as local files, so the engine never needs the network to start.
	option rule_set_dir '/etc/easyproxy/ruleset'
	option geosite_cn_url 'https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs'
	option geoip_cn_url 'https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs'
	option rule_set_update_days '7'
	# DNS: domestic resolver for CN names, remote DoH through the node group
	# for everything else.
	option dns_local_server '223.5.5.5'
	option dns_remote_server 'https://1.1.1.1/dns-query'

# Transparent capture (Stage 5). Disabled by default: turning it on makes this
# package rewrite firewall state on the router. Everything lives in its own
# `table ip easyproxy` plus one policy rule, so `easyproxy transparent remove`
# rolls it back completely.
config transparent 'transparent'
	option enabled '0'
	option tproxy_port '7891'
	option fwmark '1'
	option route_table '100'
	option lan_interfaces 'br-lan'
	option exclude ''
	# IPv6 is not captured yet (no tproxy6 path). Keeping the decision explicit
	# is the point: direct leaves IPv6 traffic unproxied, block drops LAN IPv6
	# outside the bypass set (fc00::/7, fe80::/10, ::1/128, ff00::/8 and the
	# LAN on-link prefixes) so nothing sneaks around the proxy over IPv6.
	option ipv6_policy 'direct'
	option ipv6_exclude ''

config engine 'dae'
	option config_file '/etc/easyproxy/dae.conf'
	option binary '/usr/bin/dae'

config engine 'sing_box'
	option config_file '/etc/easyproxy/sing-box.json'
	option binary '/usr/bin/sing-box'

# Node sections are optional. `easyproxy config generate` turns every enabled
# "config node" section into one sing-box outbound and puts them behind a
# latency-tested "proxy" group:
#
# config node 'hk'
#	option name 'hk-01'
#	option type 'shadowsocks'    # shadowsocks | vmess | trojan | socks | http
#	option server '203.0.113.10'
#	option port '8388'
#	option method 'aes-256-gcm'  # shadowsocks only
#	option password 'secret'     # shadowsocks / trojan / socks / http
#	option uuid 'uuid-here'      # vmess only
#	option alter_id '0'          # vmess only
#	option tls '1'               # trojan / vmess
#	option sni 'example.com'
#	option enabled '1'
