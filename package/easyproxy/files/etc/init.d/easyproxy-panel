#!/bin/sh /etc/rc.common
# EasyProxy 独立面板服务（lighttpd @ 8090，与 LuCI 的 nginx 互不干扰）

USE_PROCD=1
START=95
STOP=10

PROG=/usr/sbin/lighttpd
CONF=/etc/lighttpd-easyproxy.conf

start_service() {
	[ -x "$PROG" ] || { echo "lighttpd 未安装" >&2; return 1; }
	[ -f "$CONF" ] || { echo "缺少配置 $CONF" >&2; return 1; }
	mkdir -p /var/log

	procd_open_instance
	procd_set_param command "$PROG" -f "$CONF" -D
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# procd 会负责停；这里兜底清理残留进程
	for p in $(pidof lighttpd); do
		grep -q "lighttpd-easyproxy.conf" "/proc/$p/cmdline" 2>/dev/null && kill "$p" 2>/dev/null
	done
	return 0
}
