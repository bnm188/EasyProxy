#!/bin/sh /etc/rc.common
# EasyProxy init integration. The runtime is supervised by procd: start_service
# hands the foreground wrapper to procd, which respawns it if it dies.

START=95
STOP=10
USE_PROCD=1

. /usr/lib/easyproxy/common.sh
. /usr/lib/easyproxy/config.sh
. /usr/lib/easyproxy/transparent.sh
# The config generator of the second engine; best-effort so a trimmed install
# still boots sing-box.
EP_MIHOMO_LIB="${EP_MIHOMO_LIB:-/usr/lib/easyproxy/mihomo.sh}"
[ -r "$EP_MIHOMO_LIB" ] && . "$EP_MIHOMO_LIB"

start_service() {
	local enabled engine binary
	enabled="$(ep_bool "$(ep_get main enabled 0)")"
	[ "$enabled" = "1" ] || { ep_log "disabled in /etc/config/easyproxy; not starting"; return 0; }

	engine="$(ep_get main engine none)"
	[ "$engine" != "none" ] || { ep_log "no proxy engine selected; not starting"; return 1; }

	binary="$(ep_engine_binary "$engine")"
	[ "$(ep_binary_state "$binary")" = "available" ] || { ep_log "engine binary missing: $binary"; return 1; }

	export EP_RULE_SET_NO_FETCH=1
	if ! ep_engine_config_generate "$engine" "$(ep_engine_config_path "$engine")"; then
		ep_log "config generation failed: $EP_ERR"
		return 1
	fi

	procd_open_instance "easyproxy"
	procd_set_param command /usr/sbin/easyproxy run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile "$EP_PID_FILE"
	procd_close_instance

	ep_log "instance handed to procd (engine: $engine)"

	# Capture is only switched on once the engine is actually up: a tproxy rule
	# with no listener black-holes LAN traffic, so a failed start must leave
	# the firewall alone. Ten seconds covers a slow cold boot on small boxes.
	if ep_transparent_enabled; then
		i=0
		while [ "$i" -lt 10 ] && [ "$(ep_runtime_state)" != "running" ]; do
			sleep 1
			i=$((i + 1))
		done
		if ep_transparent_apply; then
			ep_log "transparent capture applied on $(ep_transparent_ifaces) (tproxy 0.0.0.0:$(ep_tproxy_port), ipv6 $(ep_ipv6_policy))"
		else
			ep_log "transparent capture not applied: $EP_ERR"
		fi
	fi
}

# Boot and a firewall reload both go through here: the engine is (re)started and
# the capture is rebuilt from UCI, so a restart never depends on leftover state.
boot() {
	start
}

stop_service() {
	ep_transparent_remove
	rm -f "$EP_PID_FILE"
	return 0
}

reload_service() {
	stop
	start
}
