#!/bin/sh /etc/rc.common
# EasyProxy init integration. Runtime process supervision arrives in Stage 3.

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	enabled="$(uci -q get easyproxy.main.enabled 2>/dev/null)"
	[ "$enabled" = "1" ] || return 0
	logger -t easyproxy "Start requested, but Stage 2 has no proxy runtime; refusing to alter routing."
	return 1
}

stop_service() {
	/usr/sbin/easyproxy stop >/dev/null 2>&1
	return 0
}

reload_service() {
	stop
	start
}
