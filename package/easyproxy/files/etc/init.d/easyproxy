#!/bin/sh /etc/rc.common
# EasyProxy init integration. The runtime is supervised by procd: start_service
# hands the foreground wrapper to procd, which respawns it if it dies.

START=95
STOP=10
USE_PROCD=1

. /usr/lib/easyproxy/common.sh
. /usr/lib/easyproxy/config.sh

start_service() {
	local enabled engine binary
	enabled="$(ep_bool "$(ep_get main enabled 0)")"
	[ "$enabled" = "1" ] || { ep_log "disabled in /etc/config/easyproxy; not starting"; return 0; }

	engine="$(ep_get main engine none)"
	[ "$engine" != "none" ] || { ep_log "no proxy engine selected; not starting"; return 1; }

	binary="$(ep_engine_binary "$engine")"
	[ "$(ep_binary_state "$binary")" = "available" ] || { ep_log "engine binary missing: $binary"; return 1; }

	export EP_RULE_SET_NO_FETCH=1
	if ! ep_config_build "$(ep_engine_config_path "$engine")"; then
		ep_log "config generation failed: $EP_ERR"
		return 1
	fi

	procd_open_instance "easyproxy"
	procd_set_param command /usr/sbin/easyproxy run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile "$EP_PID_FILE"
	procd_close_instance

	ep_log "instance handed to procd (engine: $engine)"
}

stop_service() {
	rm -f "$EP_PID_FILE"
	return 0
}

reload_service() {
	stop
	start
}
