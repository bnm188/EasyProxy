{
	"luci-app-easyproxy": {
		"description": "EasyProxy panel: run the CLI, read/write its UCI section, read its log",
		"read": {
			"ubus": {
				"file": [ "exec", "read", "list" ]
			},
			"uci": [ "easyproxy" ],
			"file": {
				"/etc/config/easyproxy": [ "read" ],
				"/etc/easyproxy/*": [ "read" ],
				"/var/log/easyproxy.log": [ "read" ],
				"/proc/net/dev": [ "read" ]
			}
		},
		"write": {
			"uci": [ "easyproxy" ],
			"file": {
				"/etc/easyproxy/*": [ "write" ]
			}
		}
	}
}
