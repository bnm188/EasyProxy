#!/bin/sh

. /usr/lib/easyproxy/common.sh
. /usr/lib/easyproxy/config.sh
# Second engine: same UCI nodes, rendered as Clash YAML. Loaded best-effort so a
# missing file cannot break status/start on an older package layout.
EP_MIHOMO_LIB="${EP_MIHOMO_LIB:-/usr/lib/easyproxy/mihomo.sh}"
[ -r "$EP_MIHOMO_LIB" ] && . "$EP_MIHOMO_LIB"
# Clash API reader: only useful for mihomo, but sourced unconditionally so
# `status` can report live connections without knowing which engine is set.
EP_CLASH_LIB="${EP_CLASH_LIB:-/usr/lib/easyproxy/clash.sh}"
[ -r "$EP_CLASH_LIB" ] && . "$EP_CLASH_LIB"
# Entry bypass (M1, 0.8.2): China traffic released in nft before tproxy.
# Source it *before* transparent.sh: transparent.sh keeps any EP_BYPASS_LIB it
# finds, so defining the path here lets a test sandbox redirect both modules.
EP_BYPASS_LIB="${EP_BYPASS_LIB:-/usr/lib/easyproxy/bypass.sh}"
[ -r "$EP_BYPASS_LIB" ] && . "$EP_BYPASS_LIB"
. /usr/lib/easyproxy/transparent.sh
# Share-link parsing is only needed by the node commands; a missing file must
# not break status/start, so the source is best-effort.
EP_NODE_LIB="${EP_NODE_LIB:-/usr/lib/easyproxy/node.sh}"
[ -r "$EP_NODE_LIB" ] && . "$EP_NODE_LIB"
# Maintenance (backup / restore / reset, rule-set update, doctor, log rotate)
EP_MAINT_LIB="${EP_MAINT_LIB:-/usr/lib/easyproxy/maint.sh}"
[ -r "$EP_MAINT_LIB" ] && . "$EP_MAINT_LIB"

PROG="easyproxy"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

usage() {
	cat <<EOF
EasyProxy ${EP_VERSION} — Stage ${EP_STAGE} (runtime + split routing + transparent capture)
Usage:
  easyproxy status [--json]        Show configuration and runtime status
  easyproxy validate [--json]      Validate configuration values
  easyproxy engine                 Show selected engine and binary availability
  easyproxy engine list            List available engines and their stability
  easyproxy engine health [--json] Diagnose binary, config, runtime and listen port
  easyproxy connections [--json]   Live flows via the mihomo Clash API
  easyproxy engine version         Print the engine binary's own version line
  easyproxy node list [--json]     List nodes with their auto group
  easyproxy node add <link> [name] Import one share link as a node
  easyproxy node import <file>     Import a file of share links, one per line
  easyproxy node export [name]     Print share links back out
  easyproxy node del <name>        Delete a node
  easyproxy node test [--json]     TCP-probe every enabled node (latency)
  easyproxy group list [--json]    Show the PROXY selector: current pick and members
  easyproxy group use <member>     Point PROXY at a member (node or auto-<region>)
  easyproxy group set <g> <member> Point any selector group at a member
  easyproxy rule list [--json]     List custom split rules
  easyproxy rule add <type:value:outbound>
  easyproxy rule del <index>
  easyproxy config generate        Generate the engine config from UCI nodes
  easyproxy config backup [file]   Archive the config and the CN rule sets
  easyproxy config restore <file>  Restore a backup (keeps .before-restore)
  easyproxy config reset           Put the shipped default config back
  easyproxy ruleset update         Re-download both CN rule sets
  easyproxy ruleset verify         Check both CN rule sets are real .srs files
  easyproxy doctor [--json]        One-shot diagnosis of everything that can fail
  easyproxy diag [--upload]        Write a redacted bundle (lands in /tmp unless --upload)
  easyproxy diag --set-id 001      Tag this router, bundles go to diagnostics/001/
  easyproxy diag --daily on|off    Upload one bundle a day at 03:17
  easyproxy update check           Ask GitHub for the latest release
  easyproxy update apply [ver]     Download, verify, install, verify, rollback on failure
  easyproxy update rollback        Restore the archived previous version
  easyproxy start                  Start the managed runtime
  easyproxy stop                   Stop the managed runtime
  easyproxy restart                Restart the managed runtime
  easyproxy run                    Run in the foreground (used by procd)
  easyproxy bypass status          Show entry bypass state (china traffic out of the engine)
  easyproxy bypass on|off          Enable / disable the entry bypass and re-apply rules
  easyproxy bypass restore         Break-glass: drop the capture, back to plain direct
  easyproxy transparent status     Show transparent capture state
  easyproxy transparent apply      Capture LAN traffic (nftables + policy routing)
  easyproxy transparent remove     Roll the capture back
  easyproxy transparent audit      Check the live rules, marks and IPv6 policy against UCI
  easyproxy log                    Show recent log lines
  easyproxy log rotate             Rotate the log when it exceeds main.log_max_bytes
  easyproxy traffic [iface]        Sample /proc/net/dev as JSON (panel chart)
  easyproxy subscribe <url> [prefix]  Import a subscription over http(s)
  easyproxy uninstall-clean        Remove only EasyProxy's own nft/policy rules
  easyproxy help                   Show this help
EOF
}

runtime_pid() {
	local pid
	pid="$(ep_pid)"
	printf '%s' "${pid:-0}"
}

cmd_status_text() {
	local enabled engine binary bstate china proxy fail_closed nodes
	local runtime pid up config_state config_path
	enabled="$(ep_bool "$(ep_get main enabled 0)")"
	engine="$(ep_get main engine none)"
	binary="$(ep_engine_binary "$engine")"
	bstate="$(ep_binary_state "$binary")"
	# china_policy and fail_closed are locked on their safe values; the UCI
	# values are only read to warn about them, never to change the route.
	proxy="$(ep_get routing proxy_policy proxy)"
	china="direct"
	fail_closed=1
	nodes="$(ep_node_count)"
	runtime="$(ep_runtime_state)"
	pid="$(runtime_pid)"
	up="$(ep_runtime_uptime)"
	config_path="$(ep_engine_config_path "$engine")"
	config_state="$(ep_config_state)"

	printf 'EasyProxy %s (Stage %s)\n' "$EP_VERSION" "$EP_STAGE"
	printf 'Enabled: %s\n' "$enabled"
	printf 'Engine: %s\n' "$(ep_engine_label "$engine")"
	if [ -n "$binary" ]; then
		printf 'Binary: %s (%s)\n' "$binary" "$bstate"
	else
		printf 'Binary: n/a\n'
	fi
	printf 'China policy: %s\n' "$china"
	printf 'Proxy policy: %s\n' "$proxy"
	printf 'Fail closed: %s\n' "$fail_closed"
	printf 'Nodes: %s\n' "$nodes"
	if [ "$(ep_get main engine none)" = "mihomo" ]; then
		printf 'Rule sets: builtin (geoip.metadb ships with mihomo)\n'
	elif [ "$(ep_rule_set_state)" = "ready" ]; then
		printf 'Rule sets: ready (%s)\n' "$(ep_rule_set_dir)"
	else
		printf 'Rule sets: missing (%s)\n' "$(ep_rule_set_dir)"
	fi
	case "$(ep_effective_route_mode "$(ep_get main engine none)" "$nodes")" in
		split)
			printf 'Routing: split (China direct, others proxied)\n' ;;
		*)
			if [ "$nodes" -gt 0 ]; then
				printf 'Routing: direct only (rule sets missing: nothing is proxied, foreign sites unreachable)\n'
			else
				printf 'Routing: direct only (no enabled nodes)\n'
			fi ;;
	esac
	printf 'LAN: always direct (private ranges, router addresses, local domains excluded)\n'
	[ -z "$(ep_locked_warn)" ] || printf 'Lock: %s\n' "$(ep_locked_warn)"
	case "$(ep_transparent_state)" in
		active)
			printf 'Transparent: active (%s, tproxy 0.0.0.0:%s)\n' \
				"$(ep_transparent_ifaces)" "$(ep_tproxy_port)" ;;
		unsupported)
			printf 'Transparent: unsupported (nft not available)\n' ;;
		*)
			if ep_transparent_enabled; then
				printf 'Transparent: configured but not applied (%s)\n' "$(ep_transparent_ifaces)"
			else
				printf 'Transparent: disabled\n'
			fi
			;;
	esac
	case "$(ep_ipv6_policy):$(ep_ipv6_state)" in
		direct:off) printf 'IPv6: not captured, direct (ipv6_policy=direct)\n' ;;
		block:active) printf 'IPv6: blocked for LAN clients outside the bypass set (ip6 table loaded)\n' ;;
		block:*) printf 'IPv6: policy=block but the ip6 table is %s\n' "$(ep_ipv6_state)" ;;
		*) printf 'IPv6: %s (%s)\n' "$(ep_ipv6_policy)" "$(ep_ipv6_state)" ;;
	esac
	printf 'Runtime: %s' "$runtime"
	[ "$runtime" = "running" ] && printf ' (pid %s, up %ss)' "$pid" "$up"
	printf '\n'
	printf 'Config: %s (%s)\n' "$config_path" "$config_state"
	printf 'Config file: %s\n' "$EP_CONFIG_FILE"
}

cmd_status_json() {
	local enabled engine binary bstate china proxy fail_closed nodes
	local runtime pid up config_state config_path nodes_enabled china_rule route_rules dns_mode rule_set_state route_mode
	local transparent tproxy_port tproxy_state ipv6_policy ipv6_state bypass_state bypass_cidr bypass_enabled
	local engine_stability engine_dev listen_port listen_open
	local snap rest clash_api conn_count conn_up conn_down conn_memory
	enabled="$(ep_bool "$(ep_get main enabled 0)")"
	engine="$(ep_get main engine none)"
	binary="$(ep_engine_binary "$engine")"
	bstate="$(ep_binary_state "$binary")"
	proxy="$(ep_get routing proxy_policy proxy)"
	# locked values: reported as what the router really does, not as what UCI says
	china="direct"
	fail_closed=1
	nodes="$(ep_node_count)"
	nodes_enabled="$(ep_node_count_enabled)"
	[ -n "$nodes" ] || nodes="0"
	[ -n "$nodes_enabled" ] || nodes_enabled="0"
	rule_set_state="$(ep_effective_rule_set_state "$engine")"
	transparent="$(ep_bool "$(ep_get transparent enabled 0)")"
	tproxy_port="$(ep_tproxy_port)"
	tproxy_state="$(ep_transparent_state)"
	# The bypass module is optional at run time (it is only needed once capture
	# exists); a missing module must degrade the field, not the whole status.
	if command -v ep_bypass_state >/dev/null 2>&1; then
		bypass_state="$(ep_bypass_state)"
		bypass_cidr="$(ep_bypass_cidr_count)"
		bypass_enabled="$(ep_bypass_enabled && printf '1' || printf '0')"
	else
		bypass_state="unavailable"
		bypass_cidr=0
		bypass_enabled=0
	fi
	ipv6_policy="$(ep_ipv6_policy)"
	ipv6_state="$(ep_ipv6_state)"
	engine_stability="$(ep_engine_stability "$engine")"
	engine_dev="$(ep_engine_is_dev "$engine")"
	listen_port="$(ep_get main listen_port 7890)"
	listen_open="$(ep_port_listening "$listen_port")"

	route_mode="$(ep_effective_route_mode "$engine" "$nodes_enabled")"
	if [ "$route_mode" = "split" ]; then
		china_rule=1
		route_rules=2
		dns_mode="split"
	else
		china_rule=0
		route_rules=1
		dns_mode="local"
	fi

	runtime="$(ep_runtime_state)"
	pid="$(runtime_pid)"
	up="$(ep_runtime_uptime)"
	config_path="$(ep_engine_config_path "$engine")"
	config_state="$(ep_config_state)"

	# Live connection snapshot. One curl to the loopback controller, capped at
	# 2 s, and only for mihomo; on sing-box it returns "absent" without a call.
	if command -v ep_clash_snapshot >/dev/null 2>&1; then
		snap="$(ep_clash_snapshot)"
		clash_api="${snap%%	*}"
		rest="${snap#*	}"
		conn_count="${rest%%	*}"
		rest="${rest#*	}"
		conn_up="${rest%%	*}"
		rest="${rest#*	}"
		conn_down="${rest%%	*}"
		conn_memory="${rest##*	}"
	else
		clash_api="absent"; conn_count=0; conn_up=0; conn_down=0; conn_memory=0
	fi

	printf '{"ok":true,"package":"%s","version":"%s","stage":%s,"enabled":%s,"engine":"%s","engine_stability":"%s","engine_dev":%s,"binary":"%s","binary_ok":%s,"china_policy":"%s","proxy_policy":"%s","fail_closed":%s,"nodes":%s,"nodes_enabled":%s,"runtime":"%s","runtime_pid":%s,"runtime_uptime":%s,"listen_port":%s,"listen_open":%s,"china_rule":%s,"route_rules":%s,"dns_mode":"%s","rule_set_state":"%s","route_mode":"%s","transparent":%s,"tproxy_port":%s,"tproxy_state":"%s","ipv6_policy":"%s","ipv6_state":"%s","bypass_state":"%s","bypass_cidr":%s,"bypass_enabled":%s,"config_state":"%s","config_path":"%s","config_file":"%s","generated":"%s","clash_api":"%s","connections":%s,"conn_up":%s,"conn_down":%s,"conn_memory":%s}\n' \
		"$(ep_json_escape "$PROG")" \
		"$(ep_json_escape "$EP_VERSION")" \
		"$EP_STAGE" \
		"$enabled" \
		"$(ep_json_escape "$engine")" \
		"$(ep_json_escape "$engine_stability")" \
		"$engine_dev" \
		"$(ep_json_escape "$binary")" \
		"$([ "$bstate" = "available" ] && printf '1' || printf '0')" \
		"$(ep_json_escape "$china")" \
		"$(ep_json_escape "$proxy")" \
		"$fail_closed" \
		"$nodes" \
		"$nodes_enabled" \
		"$(ep_json_escape "$runtime")" \
		"$pid" \
		"$up" \
		"$listen_port" \
		"$listen_open" \
		"$china_rule" \
		"$route_rules" \
		"$dns_mode" \
		"$(ep_json_escape "$rule_set_state")" \
		"$(ep_json_escape "$route_mode")" \
		"$transparent" \
		"$tproxy_port" \
		"$(ep_json_escape "$tproxy_state")" \
		"$(ep_json_escape "$ipv6_policy")" \
		"$(ep_json_escape "$ipv6_state")" \
		"$(ep_json_escape "$bypass_state")" \
		"$bypass_cidr" \
		"$bypass_enabled" \
		"$(ep_json_escape "$config_state")" \
		"$(ep_json_escape "$config_path")" \
		"$(ep_json_escape "$EP_CONFIG_FILE")" \
		"$(ep_utc_now)" \
		"$(ep_json_escape "$clash_api")" \
		"$conn_count" \
		"$conn_up" \
		"$conn_down" \
		"$conn_memory"
}

# Live connections, mihomo only. Text mode is for humans over ssh; --json is
# what the panel consumes, already normalised so the LuCI page never has to
# understand Clash's schema.
cmd_connections() {
	local mode
	mode="$1"
	if ! command -v ep_clash_applicable >/dev/null 2>&1 || ! ep_clash_applicable; then
		case "$mode" in
			--json|json) printf '{"ok":false,"error":"clash API is only available on the mihomo engine"}\n' ;;
			*) echo "Clash API is only available on the mihomo engine (current: $(ep_get main engine none))." ;;
		esac
		return 1
	fi
	if [ -z "$(ep_clash_get /version)" ]; then
		case "$mode" in
			--json|json) printf '{"ok":false,"error":"clash API unreachable on %s"}\n' "$(ep_clash_controller)" ;;
			*) echo "Clash API unreachable on $(ep_clash_controller): is the engine running?" ;;
		esac
		return 1
	fi
	case "$mode" in
		--json|json)
			ep_clash_connections_json ;;
		*)
			ep_clash_connections | awk -F'\t' '
				BEGIN { printf "%-44s %-16s %-14s %10s %10s %9s\n", "HOST", "SOURCE", "NODE", "UP", "DOWN", "ELAPSED" }
				{ printf "%-44s %-16s %-14s %10s %10s %9s\n", $1, $2, $3, $4, $5, ($6 == "-" || $6 == "" ? "-" : int($6 / 1000) "s") }'
			;;
	esac
}

cmd_group_list() {
	local group now members m first=1
	group="PROXY"
	if ! command -v ep_clash_applicable >/dev/null 2>&1 || ! ep_clash_applicable; then
		if [ "$JSON" = "1" ]; then
			printf '{"ok":false,"error":"the Clash API is only available on mihomo"}\n'
		else
			echo "Group switching needs the mihomo engine (current: $(ep_get main engine none))."
		fi
		return 1
	fi
	now="$(ep_clash_group_now "$group")"
	members="$(ep_clash_group_members "$group")"
	if [ -z "$members" ]; then
		if [ "$JSON" = "1" ]; then
			printf '{"ok":false,"error":"Clash API unreachable or group %s is not defined"}\n' "$group"
		else
			echo "No group ${group}: the Clash API is unreachable on $(ep_clash_controller), or the config was built before groups existed."
			echo "Run \"easyproxy config generate\" and restart."
		fi
		return 1
	fi
	if [ "$JSON" = "1" ]; then
		printf '{"ok":true,"group":"%s","now":"%s","members":[' "$group" "$(ep_json_escape "$now")"
		printf '%s\n' "$members" | while IFS= read -r m; do
			[ -n "$m" ] || continue
			[ "$first" = "1" ] || printf ','
			first=0
			printf '"%s"' "$(ep_json_escape "$m")"
		done
		printf ']}\n'
		return 0
	fi
	printf 'Group %s -> %s\n' "$group" "$now"
	printf '%s\n' "$members" | while IFS= read -r m; do
		[ -n "$m" ] || continue
		if [ "$m" = "$now" ]; then
			printf '  * %s\n' "$m"
		else
			printf '    %s\n' "$m"
		fi
	done
}

cmd_group_use() {
	local member group
	member="$1"; group="${2:-PROXY}"
	if [ -z "$member" ]; then
		echo "usage: easyproxy group use <member> [group]" >&2
		return 2
	fi
	if ep_clash_select "$group" "$member"; then
		printf 'Group %s -> %s\n' "$group" "$member"
		return 0
	fi
	echo "Could not switch ${group} to ${member}: ${EP_ERR:-unknown error}" >&2
	return 1
}

cmd_validate_text() {
	local enabled engine china fail_closed config_state
	enabled="$(ep_get main enabled 0)"
	engine="$(ep_get main engine none)"
	china="$(ep_get routing china_policy direct)"
	fail_closed="$(ep_get routing fail_closed 1)"

	case "$enabled" in 0|1) ;; *) echo "Invalid main.enabled: expected 0 or 1" >&2; return 1 ;; esac
	ep_valid_engine "$engine" || { echo "Invalid main.engine: $engine" >&2; return 1; }
	case "$china" in
		direct) ;;
		*) echo "Invalid routing.china_policy: $china (locked to direct: proxying China mainland traffic is not allowed)" >&2; return 1 ;;
	esac
	case "$fail_closed" in
		1) ;;
		*) echo "Invalid routing.fail_closed: $fail_closed (locked to 1: missing China rule sets must never degrade to a full proxy)" >&2; return 1 ;;
	esac

	echo "Configuration values are valid."
	echo "Safety check: China policy is DIRECT (locked)."
	echo "Safety check: fail_closed is 1 (locked): without the China rule sets only direct routing is generated."
	config_state="$(ep_config_state)"
	case "$config_state" in
		ok) echo "Generated engine config: present and valid." ;;
		invalid) echo "Warning: generated engine config failed validation; run 'easyproxy config generate'." ;;
		missing) echo "Note: no generated engine config yet; run 'easyproxy config generate'." ;;
	esac
}

cmd_validate_json() {
	local enabled engine china fail_closed messages code config_state
	enabled="$(ep_get main enabled 0)"
	engine="$(ep_get main engine none)"
	china="$(ep_get routing china_policy direct)"
	fail_closed="$(ep_get routing fail_closed 1)"
	messages=""
	code=0

	case "$enabled" in 0|1) ;; *) messages="${messages}\"Invalid main.enabled: expected 0 or 1\","; code=1 ;; esac
	if ! ep_valid_engine "$engine"; then
		messages="${messages}\"Invalid main.engine: $(ep_json_escape "$engine")\","; code=1
	fi
	case "$china" in
		direct) ;;
		*) messages="${messages}\"Invalid routing.china_policy: $(ep_json_escape "$china") (locked to direct)\","
			messages="${messages}\"china_policy=proxy would proxy mainland traffic; the lock keeps the CN direct rule.\","; code=1 ;;
	esac
	case "$fail_closed" in
		1) ;;
		*) messages="${messages}\"Invalid routing.fail_closed: $(ep_json_escape "$fail_closed") (locked to 1)\","
			messages="${messages}\"fail_closed=0 would degrade to a full proxy when the CN rule sets are missing.\","; code=1 ;;
	esac

	config_state="$(ep_config_state)"
	case "$config_state" in
		invalid) messages="${messages}\"Generated config failed validation; regenerate it.\","; code=1 ;;
		missing) messages="${messages}\"No generated config yet; run easyproxy config generate.\"," ;;
	esac

	[ "$code" = "0" ] && messages="${messages}\"Configuration values are valid.\",\"China policy: direct (locked)\",\"Fail closed: 1 (locked)\","
	messages="$(printf '%s' "$messages" | sed -e 's/,$//')"

	printf '{"ok":%s,"version":"%s","config_state":"%s","messages":[%s],"generated":"%s"}\n' \
		"$([ "$code" = "0" ] && printf 'true' || printf 'false')" \
		"$(ep_json_escape "$EP_VERSION")" \
		"$(ep_json_escape "$config_state")" \
		"$messages" \
		"$(ep_utc_now)"
	return "$code"
}

cmd_engine() {
	local engine binary bstate adapter version
	engine="$(ep_get main engine none)"
	echo "Selected engine: $(ep_engine_label "$engine")"
	case "$engine" in
		none) echo "No engine selected."; return 0 ;;
	esac
	binary="$(ep_engine_binary "$engine")"
	bstate="$(ep_binary_state "$binary")"
	if [ "$bstate" = "available" ]; then
		version="$(ep_engine_version "$binary")"
		echo "Binary: available ($binary${version:+, $version})"
	else
		echo "Binary: missing ($binary)"
	fi
	adapter="$(ep_engine_adapter_file "$engine")"
	if [ -n "$adapter" ] && [ -r "$adapter" ]; then
		echo "Adapter: $adapter"
	else
		echo "Adapter: missing ($adapter)"
	fi
	if [ "$(ep_engine_is_dev "$engine")" = "1" ]; then
		printf 'Status: 开发中 (dev) — %s\n' "$(ep_engine_dev_reason "$engine")"
	else
		echo "Status: stable"
	fi
	return 0
}

cmd_engine_list() {
	local name stability
	echo "Available engines:"
	while IFS=: read -r name stability; do
		[ -n "$name" ] || continue
		printf '  %-10s %s\n' "$name" "$stability"
	done <<EOF
$(ep_engine_list)
EOF
	echo "stable = runtime implemented; dev = adapter frame only, start is refused."
	return 0
}

cmd_engine_version() {
	local engine binary version
	engine="$(ep_get main engine none)"
	[ "$engine" != "none" ] || { echo "No engine selected." >&2; return 1; }
	binary="$(ep_engine_binary "$engine")"
	[ "$(ep_binary_state "$binary")" = "available" ] || { echo "Engine binary is missing: $binary" >&2; return 1; }
	version="$(ep_engine_version "$binary")"
	[ -n "$version" ] || { echo "$binary did not answer 'version'" >&2; return 1; }
	printf '%s\n' "$version"
}

cmd_engine_health() {
	local report rc items ok st name detail tag
	report="$(ep_engine_health)"
	rc=$?
	if [ "$JSON" = "1" ]; then
		items=""
		ok=true
		while IFS="$(printf '\t')" read -r st name detail; do
			[ -n "$st" ] || continue
			[ "$st" = "fail" ] && ok=false
			items="${items}${items:+,}{\"status\":\"$(ep_json_escape "$st")\",\"check\":\"$(ep_json_escape "$name")\",\"detail\":\"$(ep_json_escape "$detail")\"}"
		done <<EOF
$report
EOF
		printf '{"ok":%s,"checks":[%s]}\n' "$ok" "$items"
	else
		printf '%s\n' "$report" | while IFS="$(printf '\t')" read -r st name detail; do
			[ -n "$st" ] || continue
			case "$st" in
				ok) tag="[ok]  " ;;
				warn) tag="[warn]" ;;
				*) tag="[FAIL]" ;;
			esac
			printf '%s %s: %s\n' "$tag" "$name" "$detail"
		done
	fi
	[ "$rc" = "0" ] || return 1
}

cmd_node_test() {
	local section tag probe state ms first=1 total=0 reach=0
	if [ "$JSON" = "1" ]; then
		printf '{"ok":true,"nodes":['
		for section in $(ep_node_sections); do
			[ "$(ep_get "$section" enabled 1)" = "1" ] || continue
			probe="$(ep_node_probe "$section")"
			state="${probe%% *}"
			ms="${probe#* }"
			total=$((total + 1))
			[ "$state" = "reachable" ] && reach=$((reach + 1))
			[ "$first" = "1" ] || printf ','
			first=0
			printf '{"section":"%s","name":"%s","server":"%s","port":"%s","state":"%s","latency_ms":%s}' \
				"$(ep_json_escape "$section")" \
				"$(ep_json_escape "$(ep_node_tag "$section")")" \
				"$(ep_json_escape "$(ep_get "$section" server '')")" \
				"$(ep_json_escape "$(ep_get "$section" port '')")" \
				"$(ep_json_escape "$state")" \
				"$([ "$ms" = "-" ] && printf 'null' || printf '%s' "$ms")"
		done
		printf '],"total":%s,"reachable":%s}\n' "$total" "$reach"
		[ "$total" -gt 0 ] && [ "$reach" -eq 0 ] && return 1
		return 0
	fi
	printf '%-24s %-22s %-8s %s\n' "NODE" "SERVER:PORT" "STATE" "LATENCY"
	for section in $(ep_node_sections); do
		[ "$(ep_get "$section" enabled 1)" = "1" ] || continue
		probe="$(ep_node_probe "$section")"
		state="${probe%% *}"
		ms="${probe#* }"
		total=$((total + 1))
		[ "$state" = "reachable" ] && reach=$((reach + 1))
		printf '%-24s %-22s %-8s %s\n' \
			"$(ep_node_tag "$section")" \
			"$(ep_get "$section" server ''):$(ep_get "$section" port '')" \
			"$state" \
			"$([ "$ms" = "-" ] && printf '-' || printf '%s ms' "$ms")"
	done
	printf 'Reachable: %s/%s\n' "$reach" "$total"
	[ "$total" -gt 0 ] && [ "$reach" -eq 0 ] && return 1
	return 0
}


cmd_node_list() {
	local section first=1 region enabled
	if [ "$JSON" = "1" ]; then
		printf '{"ok":true,"nodes":['
		for section in $(ep_node_sections); do
			region="$(ep_node_region "$(ep_node_tag "$section")" "$(ep_get "$section" server '')")"
			[ "$first" = "1" ] || printf ','
			first=0
			printf '{"section":"%s","name":"%s","type":"%s","server":"%s","port":"%s","region":"%s","group":"auto-%s","enabled":%s}' \
				"$(ep_json_escape "$section")" \
				"$(ep_json_escape "$(ep_node_tag "$section")")" \
				"$(ep_json_escape "$(ep_get "$section" type '')")" \
				"$(ep_json_escape "$(ep_get "$section" server '')")" \
				"$(ep_json_escape "$(ep_get "$section" port '')")" \
				"$(ep_json_escape "$region")" \
				"$region" \
				"$([ "$(ep_get "$section" enabled 1)" = "1" ] && printf 'true' || printf 'false')"
		done
		printf '],"groups":['
		first=1
		for region in $(ep_node_regions); do
			[ "$first" = "1" ] || printf ','
			first=0
			printf '{"tag":"auto-%s","region":"%s","label":"%s","nodes":%s}' \
				"$region" "$region" "$(ep_region_label "$region")" \
				"$(ep_node_sections_in_region "$region" | wc -l | tr -d ' ')"
		done
		printf ']}\n'
		return 0
	fi
	printf '%-20s %-14s %-24s %-8s %s\n' "NODE" "TYPE" "SERVER:PORT" "REGION" "GROUP"
	for section in $(ep_node_sections); do
		region="$(ep_node_region "$(ep_node_tag "$section")" "$(ep_get "$section" server '')")"
		printf '%-20s %-14s %-24s %-8s %s\n' \
			"$(ep_node_tag "$section")" \
			"$(ep_get "$section" type '')" \
			"$(ep_get "$section" server ''):$(ep_get "$section" port '')" \
			"$(ep_region_label "$region")" \
			"auto-$region"
	done
}

cmd_node_add() {
	local uri="$1" name="$2"
	[ -n "$uri" ] || { echo "usage: easyproxy node add <share-link> [name]" >&2; return 2; }
	case "$uri" in
		*://*) ;;
		*) echo "node add expects a share link (ss:// vmess:// vless:// trojan:// hysteria2:// tuic:// socks5:// http://)" >&2; return 2 ;;
	esac
	cmd_node_import_one "$uri" "$name"
}

cmd_node_import_one() {
	local uri="$1" name="$2" section
	section="$(ep_node_import "$uri" "$name")" || return 1
	printf 'Imported %s as %s\n' "$section" "$(ep_node_tag "$section")"
	return 0
}

cmd_node_import() {
	local src="$1" uri section added=0 failed=0
	[ -n "$src" ] || { echo "usage: easyproxy node import <file|share-link>" >&2; return 2; }
	if [ -r "$src" ]; then
		# A Clash / Clash.Meta config is a YAML document, not a list of share
		# links: route it to the block importer instead of failing every line.
		if grep -q '^proxies:' "$src" 2>/dev/null; then
			ep_node_import_clash "$src"
			return $?
		fi
		while IFS= read -r uri; do
			uri="$(printf '%s' "$uri" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
			case "$uri" in
				""|\#*) continue ;;
			esac
			if section="$(ep_node_import "$uri")"; then
				added=$((added + 1))
			else
				failed=$((failed + 1))
				printf 'Failed: %s\n' "$uri" >&2
			fi
		done < "$src"
		printf 'Imported: %s, failed: %s\n' "$added" "$failed"
		[ "$failed" -eq 0 ]
		return $?
	fi
	cmd_node_import_one "$src" "$2"
}

cmd_node_import_clash() {
	local file="$1"
	[ -n "$file" ] || { echo "usage: easyproxy node import-clash <file.yaml>" >&2; return 2; }
	ep_node_import_clash "$file"
}

cmd_node_export() {
	local want="$1" section printed=0 uri
	if [ -n "$want" ]; then
		section="$(ep_node_resolve "$want")" || { echo "no such node: $want" >&2; return 1; }
		ep_node_export_uri "$section"
		return $?
	fi
	for section in $(ep_node_sections); do
		uri="$(ep_node_export_uri "$section")" || continue
		[ -n "$uri" ] || continue
		printf '%s\n' "$uri"
		printed=$((printed + 1))
	done
	[ "$printed" -gt 0 ] || { echo "no exportable node" >&2; return 1; }
	return 0
}

cmd_node_enabled() {
	local want="$1" val="$2" section word
	[ -n "$want" ] || { echo "usage: easyproxy node enable|disable <name|server|section>" >&2; return 2; }
	section="$(ep_node_resolve "$want")" || { echo "no such node: $want" >&2; return 1; }
	uci -q set "${EP_CONFIG}.${section}.enabled=${val}" || return 1
	uci -q commit "$EP_CONFIG" 2>/dev/null
	[ "$val" = "1" ] && word=enabled || word=disabled
	printf '%s %s\n' "$word" "$(ep_node_tag "$section")"
}

cmd_node_del() {
	local want="$1" section
	[ -n "$want" ] || { echo "usage: easyproxy node del <name|server|section>" >&2; return 2; }
	section="$(ep_node_delete "$want")" || return 1
	printf 'Deleted %s\n' "$section"
}

cmd_rule_list() {
	local entry idx=0
	if [ "$JSON" = "1" ]; then
		printf '{"ok":true,"rules":['
		for entry in $(ep_rule_entries); do
			[ -n "$entry" ] || continue
			idx=$((idx + 1))
			[ "$idx" = "1" ] || printf ','
			printf '{"index":%s,"type":"%s","value":"%s","outbound":"%s"}' \
				"$idx" \
				"$(ep_json_escape "${entry%%:*}")" \
				"$(ep_json_escape "$(printf '%s' "${entry#*:}" | sed 's/:.*//')")" \
				"$(ep_json_escape "${entry##*:}")"
		done
		printf ']}\n'
		return 0
	fi
	printf '%-4s %-16s %-40s %s\n' "#" "TYPE" "VALUE" "OUTBOUND"
	for entry in $(ep_rule_entries); do
		[ -n "$entry" ] || continue
		idx=$((idx + 1))
		printf '%-4s %-16s %-40s %s\n' "$idx" "${entry%%:*}" \
			"$(printf '%s' "${entry#*:}" | sed 's/:.*//')" "${entry##*:}"
	done
	[ "$idx" -gt 0 ] || echo "No custom rules (add one with: easyproxy rule add domain-suffix:example.com:proxy)"
}

cmd_rule_add() {
	local entry="$1"
	[ -n "$entry" ] || { echo "usage: easyproxy rule add <type:value:outbound>" >&2; return 2; }
	ep_rule_add "$entry" || return 1
}

# `easyproxy binary path` — where the engine binary really is. The panel's
# "内核" card and doctor both need this answer after a reset or an upgrade that
# left a stale path behind.
cmd_binary() {
	local action="${1:-path}" engine binary
	case "$action" in
		path|show) ;;
		*) echo "Unknown binary action: $action" >&2; return 2 ;;
	esac
	engine="$(ep_get main engine sing-box)"
	binary="$(ep_engine_binary "$engine")"
	if [ "$JSON" = "1" ]; then
		printf '{"engine":"%s","binary":"%s","state":"%s"}\n' \
			"$(ep_json_escape "$engine")" \
			"$(ep_json_escape "$binary")" \
			"$(ep_binary_state "$binary")"
	else
		printf '%s\n' "$binary"
	fi
	return 0
}

cmd_rule_del() {
	local idx="$1" spec="" n=0 entry old_ifs
	[ -n "$idx" ] || { echo "usage: easyproxy rule del <index|type:value:outbound>" >&2; return 2; }
	case "$idx" in
		*[!0-9]*)
			# Rule specs are what `rule add` and `rule list` show, so accepting
			# the same string here is the natural way to delete one. Only the
			# index worked before, which made a delete look like it had no effect.
			spec="$idx"
			old_ifs="$IFS"
			IFS=';'
			for entry in $(ep_get routing custom_rules ''); do
				n=$((n + 1))
				if [ "$entry" = "$spec" ]; then idx="$n"; break; fi
			done
			IFS="$old_ifs"
			case "$idx" in
				*[!0-9]*) echo "no rule matches: $spec" >&2; return 1 ;;
			esac
			;;
	esac
	ep_rule_delete "$idx" || return 1
	printf 'Deleted rule #%s\n' "$idx"
}

cmd_config_generate() {
	local engine binary path nodes final checked generated_ok
	engine="$(ep_get main engine none)"
	[ "$engine" != "none" ] || { echo "Config generation failed: no proxy engine selected" >&2; return 1; }
	case "$engine" in
		sing-box|mihomo) : ;;
		*) printf 'Config generation failed: no config generator for %s yet (still 开发中 / dev)\n' "$engine" >&2; return 1 ;;
	esac
	path="$(ep_engine_config_path "$engine")"
	binary="$(ep_engine_binary "$engine")"
	if [ "$(ep_binary_state "$binary")" = "available" ]; then
		checked=true
	else
		checked=false
	fi

	generated_ok=0
	ep_engine_config_generate "$engine" "$path" && generated_ok=1
	if [ "$generated_ok" != "1" ]; then
		if [ "$JSON" = "1" ]; then
			printf '{"ok":false,"error":"%s"}\n' "$(ep_json_escape "$EP_ERR")"
		fi
		echo "Config generation failed: $EP_ERR" >&2
		return 1
	fi
	nodes="${EP_NODES:-0}"
	final="${EP_FINAL:-direct}"

	if [ "$JSON" = "1" ]; then
		printf '{"ok":true,"path":"%s","outbounds":%s,"nodes":%s,"final":"%s","route_mode":"%s","rule_sets":%s,"checked":%s,"generated":"%s"}\n' \
			"$(ep_json_escape "$path")" \
			"$((nodes + 2))" \
			"$nodes" \
			"$(ep_json_escape "$final")" \
			"$(ep_json_escape "${EP_ROUTE_MODE:-direct}")" \
			"${EP_SPLIT:-0}" \
			"$checked" \
			"$(ep_utc_now)"
	else
		printf 'Config generated: %s\n' "$path"
		printf 'Enabled nodes: %s\n' "$nodes"
		printf 'Default route: %s\n' "$final"
		case "${EP_ROUTE_MODE:-direct}" in
			split)
				echo "Routing mode: split (China direct, others proxied)" ;;
			*)
				echo "Routing mode: direct only (nothing is proxied; LAN stays direct)" ;;
		esac
		if [ "$checked" = "true" ]; then
			echo "Engine validation: passed"
		else
			echo "Engine validation: skipped (binary missing)"
		fi
	fi
	[ "$nodes" -gt 0 ] || echo "Warning: no enabled nodes; generated config only provides direct routing." >&2
	[ -z "${EP_WARN:-}" ] || printf 'Warning: %s\n' "$EP_WARN" >&2
	return 0
}

cmd_start() {
	local enabled engine binary log i
	enabled="$(ep_bool "$(ep_get main enabled 0)")"
	[ "$enabled" = "1" ] || { echo "EasyProxy is disabled. Set easyproxy.main.enabled=1 to enable." >&2; return 1; }
	engine="$(ep_get main engine none)"
	[ "$engine" != "none" ] || { echo "No proxy engine selected." >&2; return 1; }
	[ "$(ep_engine_is_dev "$engine")" = "0" ] || { printf '%s is 开发中 (dev): %s\n' "$engine" "$(ep_engine_dev_reason "$engine")" >&2; return 2; }
	binary="$(ep_engine_binary "$engine")"
	[ "$(ep_binary_state "$binary")" = "available" ] || { echo "Engine binary is missing: $binary" >&2; return 1; }

	if [ "$(ep_runtime_state)" = "running" ]; then
		echo "EasyProxy is already running (pid $(ep_pid))."
		return 0
	fi

	if ! ep_engine_config_generate "$engine" "$(ep_engine_config_path "$engine")"; then
		echo "Config generation failed: $EP_ERR" >&2
		return 1
	fi
	[ -z "${EP_WARN:-}" ] || printf 'Warning: %s\n' "$EP_WARN" >&2

	mkdir -p "$EP_RUNTIME_DIR" 2>/dev/null
	log="$EP_LOG_FILE"
	: >> "$log" 2>/dev/null || log="/dev/null"

	if [ -x /etc/init.d/easyproxy ]; then
		/etc/init.d/easyproxy start >/dev/null 2>&1
	else
		nohup "$SELF" run >> "$log" 2>&1 &
	fi

	# Wait for the wrapper to publish its pid file (engine startup is not instant)
	i=0
	while [ "$i" -lt 5 ]; do
		if [ "$(ep_runtime_state)" = "running" ]; then
			echo "EasyProxy started (pid $(ep_pid))."
			if ep_transparent_enabled; then
				if ep_transparent_apply; then
					echo "Transparent capture applied ($(ep_transparent_ifaces) → tproxy 0.0.0.0:$(ep_tproxy_port))."
				else
					printf 'Warning: transparent capture not applied: %s\n' "$EP_ERR" >&2
				fi
			fi
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	echo "EasyProxy failed to start; see $EP_LOG_FILE" >&2
	if ep_transparent_enabled; then
		echo "Hint: transparent capture is enabled. If the log shows 'configure tproxy TCP listener: operation not permitted', the kernel lacks nftables TPROXY support; install the tproxy kmod or set easyproxy.transparent.enabled=0." >&2
	fi
	return 1
}

cmd_stop() {
	local pid i
	# Drop the capture first: captured packets must not land on a closing port.
	ep_transparent_remove
	if [ -x /etc/init.d/easyproxy ]; then
		/etc/init.d/easyproxy stop >/dev/null 2>&1
	fi
	pid="$(ep_pid)"
	if [ -z "$pid" ]; then
		rm -f "$EP_PID_FILE"
		echo "EasyProxy is not running."
		return 0
	fi
	kill "$pid" 2>/dev/null
	i=0
	while [ -d "/proc/$pid" ] && [ "$i" -lt 5 ]; do
		kill -TERM "$pid" 2>/dev/null
		sleep 1
		i=$((i + 1))
	done
	[ -d "/proc/$pid" ] && kill -9 "$pid" 2>/dev/null
	rm -f "$EP_PID_FILE"
	echo "EasyProxy stopped."
	return 0
}

cmd_restart() {
	cmd_stop >/dev/null
	cmd_start
}

cmd_transparent() {
	local action state _report _rc _items _ok _st _name _detail _tag
	action="${1:-status}"
	state="$(ep_transparent_state)"
	case "$action" in
		status)
			if [ "$JSON" = "1" ]; then
				printf '{"ok":true,"enabled":%s,"state":"%s","port":%s,"fwmark":%s,"route_table":%s,"interfaces":"%s","ipv6_policy":"%s","ipv6_state":"%s","nft":"%s","nft_available":%s,"file":"%s","generated":"%s"}\n' \
					"$(ep_bool "$(ep_get transparent enabled 0)")" \
					"$(ep_json_escape "$state")" \
					"$(ep_tproxy_port)" \
					"$(ep_transparent_fwmark)" \
					"$(ep_transparent_route_table)" \
					"$(ep_json_escape "$(ep_transparent_ifaces)")" \
					"$(ep_json_escape "$(ep_ipv6_policy)")" \
					"$(ep_json_escape "$(ep_ipv6_state)")" \
					"$(ep_json_escape "$EP_NFT_BIN")" \
					"$([ "$state" = "unsupported" ] && printf 'false' || printf 'true')" \
					"$(ep_json_escape "$EP_NFT_FILE")" \
					"$(ep_utc_now)"
			else
				printf 'Enabled: %s\n' "$(ep_bool "$(ep_get transparent enabled 0)")"
				printf 'State: %s\n' "$state"
				printf 'Capture: %s → tproxy 0.0.0.0:%s\n' "$(ep_transparent_ifaces)" "$(ep_tproxy_port)"
				printf 'Fwmark: %s (route table %s)\n' "$(ep_transparent_fwmark)" "$(ep_transparent_route_table)"
				printf 'IPv6 policy: %s (%s)\n' "$(ep_ipv6_policy)" "$(ep_ipv6_state)"
				printf 'Rule file: %s\n' "$EP_NFT_FILE"
			fi
			;;
		audit)
			_report="$(ep_transparent_audit)"
			_rc=$?
			if [ "$JSON" = "1" ]; then
				_items=""
				_ok=true
				while IFS="$(printf '\t')" read -r _st _name _detail; do
					[ -n "$_st" ] || continue
					[ "$_st" = "fail" ] && _ok=false
					_items="${_items}${_items:+,}{\"status\":\"$(ep_json_escape "$_st")\",\"check\":\"$(ep_json_escape "$_name")\",\"detail\":\"$(ep_json_escape "$_detail")\"}"
				done <<EOF
$_report
EOF
				printf '{"ok":%s,"checks":[%s]}\n' "$_ok" "$_items"
			else
				printf '%s\n' "$_report" | while IFS="$(printf '\t')" read -r _st _name _detail; do
					[ -n "$_st" ] || continue
					case "$_st" in
						ok) _tag="[ok]  " ;;
						warn) _tag="[warn]" ;;
						*) _tag="[FAIL]" ;;
					esac
					printf '%s %s: %s\n' "$_tag" "$_name" "$_detail"
				done
			fi
			[ "$_rc" = "0" ] || return 1
			;;
		apply)
			if ep_transparent_apply; then
				printf 'Transparent capture applied: %s → tproxy 0.0.0.0:%s (fwmark %s, table %s)\n' \
					"$(ep_transparent_ifaces)" "$(ep_tproxy_port)" \
					"$(ep_transparent_fwmark)" "$(ep_transparent_route_table)"
				printf 'Rules: %s\n' "$EP_NFT_FILE"
			else
				if [ "$JSON" = "1" ]; then
					printf '{"ok":false,"error":"%s"}\n' "$(ep_json_escape "$EP_ERR")"
				fi
				printf 'Transparent capture failed: %s\n' "$EP_ERR" >&2
				return 1
			fi
			;;
		remove)
			ep_transparent_remove
			echo "Transparent capture removed."
			;;
		*)
			echo "Unknown transparent action: $action" >&2
			return 2
			;;
	esac
	return 0
}

cmd_bypass() {
	local action state
	action="$1"
	[ -n "$action" ] || action=status
	if ! command -v ep_bypass_state >/dev/null 2>&1; then
		echo "Entry bypass module is missing: /usr/lib/easyproxy/bypass.sh" >&2
		return 1
	fi
	state="$(ep_bypass_state)"
	case "$action" in
		status)
			if [ "$JSON" = "1" ]; then
				printf '{"ok":true,"state":"%s","enabled":%s,"cidr":%s,"file":"%s"}\n' \
					"$(ep_json_escape "$state")" \
					"$([ "$state" = "disabled" ] && printf 0 || printf 1)" \
					"$(ep_bypass_cidr_count)" \
					"$(ep_json_escape "$(ep_bypass_cidr_file)")"
			else
				printf 'entry bypass: %s (china cidr: %s entries, %s)\n' \
					"$state" "$(ep_bypass_cidr_count)" "$(ep_bypass_cidr_file)"
				case "$state" in
					active) echo "china traffic is released in nft before tproxy: it never enters the engine" ;;
					ready) echo "list is valid but capture is off: run 'easyproxy transparent apply'" ;;
					missing) echo "china cidr list is missing or invalid: run 'easyproxy bypass fetch'" ;;
					disabled) echo "entry bypass is off: china traffic enters the engine and is sent direct there" ;;
					unsupported) echo "nftables is not usable on this host: entry bypass unavailable" ;;
				esac
			fi
			;;
		on|enable)
			ep_bypass_on || { printf 'bypass on failed: %s\n' "$EP_ERR" >&2; return 1; }
			ep_bypass_apply_after_change || { printf 'bypass on: re-apply failed: %s\n' "$EP_ERR" >&2; return 1; }
			echo "Entry bypass enabled."
			;;
		off|disable)
			ep_bypass_off || { printf 'bypass off failed: %s\n' "$EP_ERR" >&2; return 1; }
			echo "Entry bypass disabled."
			;;
		restore|rescue)
			ep_bypass_restore || { printf 'bypass restore failed: %s\n' "$EP_ERR" >&2; return 1; }
			echo "Restored to direct: capture removed, router can reach the internet normally."
			;;
		*) echo "Unknown bypass action: $action" >&2; return 2 ;;
	esac
	return 0
}

cmd_run() {
	local engine binary cfg child rc adapter
	# Rule sets are prepared by `config generate`; never block boot on a download
	EP_RULE_SET_NO_FETCH=1
	engine="$(ep_get main engine none)"
	[ "$(ep_bool "$(ep_get main enabled 0)")" = "1" ] || { echo "EasyProxy is disabled." >&2; return 1; }
	[ "$engine" != "none" ] || { echo "No proxy engine selected." >&2; return 1; }
	[ "$(ep_engine_is_dev "$engine")" = "0" ] || { printf '%s is 开发中 (dev): %s\n' "$engine" "$(ep_engine_dev_reason "$engine")" >&2; return 2; }
	binary="$(ep_engine_binary "$engine")"
	[ "$(ep_binary_state "$binary")" = "available" ] || { echo "Engine binary is missing: $binary" >&2; return 1; }
	cfg="$(ep_engine_config_path "$engine")"
	ep_engine_config_generate "$engine" "$cfg" || { echo "Config generation failed: $EP_ERR" >&2; return 1; }

	child=""
	mkdir -p "$EP_RUNTIME_DIR" 2>/dev/null
	printf '%s %s\n' "$$" "$(date +%s)" > "$EP_PID_FILE"

	cleanup() {
		[ -n "$child" ] && kill "$child" 2>/dev/null
		rm -f "$EP_PID_FILE"
	}
	trap 'cleanup; exit 0' INT TERM

	ep_log "starting $engine with $binary"
	# The engine's own log lands in the same file the panel reads. procd already
	# captures stdout to syslog, but a file is what "日志中心" and `doctor` look at.
	# Start through the adapter: sing-box takes `run -c`, mihomo takes `-f -d`,
	# and only the adapter knows which. It runs in a subshell so its exec
	# replaces that subshell and the parent still sees the engine's exit code.
	# Without an adapter (sandbox, partial install) fall back to the sing-box
	# command line, which is what this code did before mihomo existed.
	adapter="$(ep_engine_adapter_file "$engine")"
	if [ -n "${EP_LOG_FILE:-}" ] && [ -d "$(dirname "$EP_LOG_FILE")" ]; then
		[ -e "$EP_LOG_FILE" ] || { ( umask 077; : >> "$EP_LOG_FILE" ); chmod 600 "$EP_LOG_FILE" 2>/dev/null; }
		echo "=== $(date '+%Y-%m-%d %H:%M:%S') engine start: $binary ===" >> "$EP_LOG_FILE" 2>/dev/null
		if [ -n "$adapter" ] && [ -r "$adapter" ]; then
			( ep_engine_verb "$engine" run ) >> "$EP_LOG_FILE" 2>&1 &
		else
			"$binary" run -c "$cfg" >> "$EP_LOG_FILE" 2>&1 &
		fi
	else
		if [ -n "$adapter" ] && [ -r "$adapter" ]; then
			( ep_engine_verb "$engine" run ) &
		else
			"$binary" run -c "$cfg" &
		fi
	fi
	child=$!
	wait "$child"
	rc=$?
	cleanup
	ep_log "engine exited with code $rc"
	return "$rc"
}

# Shared renderer for "<status>\t<name>\t<detail>" reports (doctor / health / audit)
cmd_report() {
	local report rc items ok st name detail tag
	report="$1"
	rc="$2"
	if [ "$JSON" = "1" ]; then
		items=""
		ok=true
		while IFS="$(printf '\t')" read -r st name detail; do
			[ -n "$st" ] || continue
			[ "$st" = "fail" ] && ok=false
			items="${items}${items:+,}{\"status\":\"$(ep_json_escape "$st")\",\"check\":\"$(ep_json_escape "$name")\",\"detail\":\"$(ep_json_escape "$detail")\"}"
		done <<EOF
$report
EOF
		printf '{"ok":%s,"checks":[%s]}\n' "$ok" "$items"
	else
		printf '%s\n' "$report" | while IFS="$(printf '\t')" read -r st name detail; do
			[ -n "$st" ] || continue
			case "$st" in
				ok) tag="[ok]  " ;;
				warn) tag="[warn]" ;;
				*) tag="[FAIL]" ;;
			esac
			printf '%s %-10s %s\n' "$tag" "$name" "$detail"
		done
	fi
	return "$rc"
}

cmd_doctor() {
	local report rc counts
	report="$(ep_doctor)"
	rc=$?
	counts="$(printf '%s\n' "$report" | awk -F'\t' '
		{ if ($1 == "ok") o++; else if ($1 == "warn") w++; else if ($1 == "fail") f++ }
		END { printf "%d ok, %d warn, %d fail", o, w, f }')"
	if [ "$JSON" = "0" ]; then
		cmd_report "$report" "$rc"
		printf 'doctor: %s\n' "$counts"
	else
		cmd_report "$report" "$rc"
	fi
	[ "$rc" -eq 0 ] || return 1
	return 0
}

cmd_ruleset() {
	local action="${1:-verify}" report rc
	case "$action" in
		update|update-all)
			ep_ruleset_update || return 1
			;;
		verify|check|status)
			report="$(ep_ruleset_verify)"
			rc=$?
			printf '%s\n' "$report"
			[ "$rc" -eq 0 ] || return 1
			;;
		*)
			echo "Unknown ruleset action: $action" >&2
			return 2
			;;
	esac
	return 0
}

cmd_config_backup() {
	local path
	path="$(ep_config_backup "$1")" || return 1
	if [ "$JSON" = "1" ]; then
		printf '{"ok":true,"path":"%s","size":%s}\n' "$(ep_json_escape "$path")" "$(ep_file_size "$path")"
	else
		printf 'Backup written: %s (%s bytes)\n' "$path" "$(ep_file_size "$path")"
	fi
	return 0
}

cmd_config_restore() {
	local path
	path="$(ep_config_restore "$1")" || return 1
	if [ "$JSON" = "1" ]; then
		printf '{"ok":true,"path":"%s"}\n' "$(ep_json_escape "$path")"
	else
		printf 'Configuration restored: %s\n' "$path"
		printf 'Previous configuration kept as %s.before-restore\n' "$EP_CONFIG_FILE"
	fi
	return 0
}

cmd_config_reset() {
	local path
	path="$(ep_config_reset)" || return 1
	if [ "$JSON" = "1" ]; then
		printf '{"ok":true,"path":"%s"}\n' "$(ep_json_escape "$path")"
	else
		printf 'Configuration reset to defaults: %s\n' "$path"
		printf 'Previous configuration kept as %s.before-reset\n' "$EP_CONFIG_FILE"
	fi
	return 0
}

cmd_uninstall_clean() {
	ep_uninstall_clean
	[ "$JSON" = "1" ] && printf '{"ok":true,"clean":"own-rules-only"}\n'
	return 0
}

cmd_log() {
	local action="${1:-show}"
	case "$action" in
		rotate)
			ep_log_rotate || return 1
			;;
		*)
			if [ -r "$EP_LOG_FILE" ]; then
				tail -n 40 "$EP_LOG_FILE"
			else
				echo "No log at $EP_LOG_FILE yet."
			fi
			;;
	esac
	return 0
}


# --- diagnostics -------------------------------------------------------------
# Every customer machine files its bundles under its own number so a year of
# reports stays a directory listing instead of a flat pile:
#   diagnostics/001/<ts>-<host>.txt
# The number is assigned at hand-over (`easyproxy diag --set-id 001`) and stored
# in a 0600 file, never in UCI (UCI goes into the bundle itself).
EP_DIAG_ID_FILE="${EP_DIAG_ID_FILE:-/etc/easyproxy/customer.id}"
EP_CRONTAB="${EP_CRONTAB:-/etc/crontabs/root}"
EP_DIAG_CRON_TAG="# easyproxy-daily-diag"

diag_customer_id() {
	[ -r "$EP_DIAG_ID_FILE" ] || return 0
	tr -d ' \r\n' < "$EP_DIAG_ID_FILE" 2>/dev/null | head -n 1
}

diag_set_id() {
	local id
	id="$(printf '%s' "$1" | tr -d ' \r\n')"
	case "$id" in
		''|*[!0-9]*) echo "diag: customer id must be digits only, e.g. 001" >&2; return 2 ;;
	esac
	[ "${#id}" -le 6 ] || { echo "diag: customer id is too long" >&2; return 2; }
	mkdir -p "$(dirname "$EP_DIAG_ID_FILE")" 2>/dev/null
	( umask 077; printf '%s\n' "$id" > "$EP_DIAG_ID_FILE" ) || {
		echo "diag: cannot write $EP_DIAG_ID_FILE" >&2; return 1; }
	chmod 600 "$EP_DIAG_ID_FILE" 2>/dev/null || true
	echo "diag: customer id set to $id ($EP_DIAG_ID_FILE)"
	echo "diag: bundles will go to diagnostics/$id/ in ${EP_DIAG_REPO:-bnm188/EasyProxy-Diag}"
	return 0
}

# One upload a day keeps the repository readable: the router's own log is the
# live view, the repository is the archive. cron is busybox crond on OpenWrt.
diag_daily() {
	local state line
	state="$1"
	case "$state" in
		on|enable|1|"") ;;
		off|disable|0)
			mkdir -p "$(dirname "$EP_CRONTAB")" 2>/dev/null
			[ -f "$EP_CRONTAB" ] || { echo "diag: no daily job configured"; return 0; }
			# grep exits 1 when every line matched (nothing left), which is not a
			# failure: the file must still be replaced.
			grep -v -e 'easyproxy diag --auto' "$EP_CRONTAB" > "$EP_CRONTAB.tmp" 2>/dev/null || true
			mv -f "$EP_CRONTAB.tmp" "$EP_CRONTAB"
			echo "diag: daily upload disabled"
			/etc/init.d/cron restart >/dev/null 2>&1 || true
			return 0 ;;
		*)
			echo "diag: --daily takes on or off" >&2; return 2 ;;
	esac
	mkdir -p "$(dirname "$EP_CRONTAB")" 2>/dev/null || {
		echo "diag: cannot create $(dirname "$EP_CRONTAB")" >&2; return 1; }
	if [ -f "$EP_CRONTAB" ]; then
		grep -v 'easyproxy diag --auto' "$EP_CRONTAB" > "$EP_CRONTAB.tmp" 2>/dev/null || true
		mv -f "$EP_CRONTAB.tmp" "$EP_CRONTAB"
	fi
	# Every 15 days (1st / 16th / 31st), not nightly: one 30 KB bundle twice a
	# month is enough to see a trend, and it keeps the 1 GB monthly upload quota
	# far out of reach.
	line="17 3 */15 * * /usr/sbin/easyproxy diag --auto >/dev/null 2>&1 $EP_DIAG_CRON_TAG"
	printf '%s\n' "$line" >> "$EP_CRONTAB"
	chmod 600 "$EP_CRONTAB" 2>/dev/null || true
	/etc/init.d/cron enable >/dev/null 2>&1 || true
	/etc/init.d/cron restart >/dev/null 2>&1 || true
	echo "diag: daily upload enabled (03:17 every day)"
	return 0
}

# A bundle a human can read on GitHub. Everything that carries a credential is
# masked before the file leaves the router: share links put the secret in the
# URL, subscriptions put a token in the query string, node configs put the
# password in JSON. Uploading is always opt-in (--upload), never automatic.
diag_redact() {
	sed -E \
		-e 's#(ssr?|vmess|vless|trojan|hysteria2?|tuic|wireguard)://[^ "'"'"'<>\\]+#\1://***#g' \
		-e 's#([?&](token|key|auth|password|passwd|uuid|user|pwd)=)[^& "'"'"'<>]+#\1***#g' \
		-e 's#([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})#***uuid***#g' \
		-e 's#("(password|uuid|token|api_key|psk|private_key)"[[:space:]]*:[[:space:]]*")[^"]*"#\1***"#g'
}

diag_add() { diag_redact >> "$DIAG_OUT"; }

diag_section() { printf '\n--- %s ---\n' "$1" >> "$DIAG_OUT"; }

diag_collect() {
	DIAG_OUT="$1"
	{
		printf '# EasyProxy diagnostic bundle\n'
		printf '# generated: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)"
		printf '# version: %s  stage: %s\n' "${EP_VERSION:-?}" "${EP_STAGE:-?}"
		printf '# host: %s\n' "$(uname -n 2>/dev/null)"
	} >> "$DIAG_OUT"

	diag_section host
	{ uname -a; uptime; free -m 2>/dev/null; cat /etc/openwrt_release 2>/dev/null; } | diag_add

	diag_section config
	{ uci show easyproxy 2>/dev/null; } | diag_add

	diag_section status
	{ "$SELF" status 2>&1; echo; "$SELF" engine health 2>&1; echo; "$SELF" bypass status 2>&1; echo; "$SELF" transparent audit 2>&1; } | diag_add

	diag_section packages
	{
		if command -v opkg >/dev/null 2>&1; then
			opkg list-installed 2>/dev/null | grep -E '^(easyproxy|sing-box|dae|luci-base|rpcd|nftables)' 
		fi
		if command -v apk >/dev/null 2>&1; then
			apk info -e easyproxy 2>/dev/null
			apk list --installed 2>/dev/null | grep -E '^(easyproxy|sing-box|dae|luci-base)' 
		fi
	} | diag_add

	diag_section files
	{
		ls -l /usr/sbin/easyproxy /etc/init.d/easyproxy 2>&1
		ls -l /usr/share/luci/menu.d/luci-app-easyproxy.json /usr/share/rpcd/acl.d/luci-app-easyproxy.json 2>&1
		ls -l /www/luci-static/resources/easyproxy/app.js 2>&1
		ls -ld /www/luci-static/resources/view/easyproxy 2>&1
		ls -l /usr/bin/sing-box /usr/bin/dae 2>&1
		# a static kernel another package installed is worth seeing explicitly
		for p in /opt/open-box/bin/sing-box /usr/local/bin/sing-box; do
			[ -e "$p" ] && ls -l "$p" 2>&1
		done
	} | diag_add

	diag_section listen
	{ netstat -ltnp 2>/dev/null | head -20; ss -ltnp 2>/dev/null | head -20; } | diag_add

	diag_section nft
	{ nft list tables 2>&1 | head -30; } | diag_add

	diag_section logs
	{ logread -e easyproxy 2>/dev/null | tail -200; tail -n 200 /var/log/easyproxy.log 2>/dev/null; } | diag_add

	diag_section dmesg
	{ dmesg 2>/dev/null | tail -60; } | diag_add

	printf '%s' "$DIAG_OUT"
}

# PUT one file into the repository through the Contents API. curl cannot be
# assumed on a router, so busybox wget is the fallback. A token is required and
# is kept in a 0600 file - never in UCI, where it would land in the bundle.
# A customer's own cloud (Nutstore, Nextcloud, Synology) exposes WebDAV: the
# bundle is one PUT to a folder, no GitHub repository and no token involved.
# The app password never appears on the command line - `ps` is world-readable on
# OpenWrt - so it is handed to curl through a private netrc file instead.
diag_upload_webdav() {
	local file url user pass pass_file dest code host netrc id conf
	file="$1"
	# One 600 file can carry all three values (URL / account / password), which
	# keeps the account out of uci: `/etc/config/easyproxy` is readable by any
	# root shell, and a customer's mailbox is not something to leave there.
	conf="${EP_DIAG_CONF:-/etc/easyproxy/diag.conf}"
	url="${EP_DIAG_WEBDAV:-}"
	user="${EP_DIAG_USER:-}"
	pass=""
	if [ -r "$conf" ]; then
		url="${url:-$(sed -n '1p' "$conf" 2>/dev/null)}"
		user="${user:-$(sed -n '2p' "$conf" 2>/dev/null)}"
		pass="$(sed -n '3p' "$conf" 2>/dev/null)"
	fi
	url="${url:-$(ep_get main diag_webdav '')}"
	user="${user:-$(ep_get main diag_user '')}"
	pass_file="${EP_DIAG_PASS_FILE:-/etc/easyproxy/diag.pass}"
	if [ -z "$pass" ] && [ ! -r "$pass_file" ]; then
		echo "diag: no password at $pass_file" >&2
		echo "diag: save the WebDAV app password there, then chmod 600 it" >&2
		return 3
	fi
	if [ -z "$pass" ]; then
		pass="$(tr -d ' \r\n' < "$pass_file")"
		[ -n "$pass" ] || { echo "diag: the password file $pass_file is empty" >&2; return 3; }
	fi
	if ! command -v curl >/dev/null 2>&1; then
		echo "diag: WebDAV upload needs curl; install it: opkg install curl" >&2
		return 3
	fi
	host="$(printf '%s' "$url" | sed -n 's#^http://\([^/]*\).*#\1#p;s#^https://\([^/]*\).*#\1#p')"
	[ -n "$host" ] || { echo "diag: cannot parse the host out of $url" >&2; return 3; }
	id="$(diag_customer_id)"
	[ -n "$id" ] || id="unassigned"
	dest="${url%/}/${id}/$(date -u '+%Y%m%dT%H%M%SZ')-$(uname -n 2>/dev/null | tr -c 'A-Za-z0-9_.-' '_').txt"
	netrc="$(mktemp 2>/dev/null || echo /tmp/easyproxy-diag.netrc)"
	( umask 077; printf 'machine %s login %s password %s\n' "$host" "$user" "$pass" > "$netrc" )
	# WebDAV creates nothing implicitly: PUT into a missing folder fails with 409,
	# so the per-customer folder is created first. 201 = created, 405 = already
	# there; both are fine, and neither may stop the upload.
	curl -s -o /dev/null -X MKCOL --netrc-file "$netrc" "${url%/}/${id}/" 2>/dev/null
	code="$(curl -s -o /dev/null -w '%{http_code}' -T "$file" --netrc-file "$netrc" "$dest" 2>/dev/null)"
	rm -f "$netrc"
	case "$code" in
		200|201|204) echo "diag: uploaded to $dest"; return 0 ;;
		401|403)
			echo "diag: WebDAV rejected the credentials (HTTP $code); bundle kept locally: $file" >&2
			return 5 ;;
		*)
			echo "diag: WebDAV upload failed (HTTP ${code:-000}); bundle kept locally: $file" >&2
			return 4 ;;
	esac
}

diag_upload() {
	local file token token_file repo branch name api payload tmp rc id
	file="$1"
	# A WebDAV target takes precedence: it needs no GitHub token, and a router
	# that cannot hold a token is exactly the one that needs this path.
	if [ -n "${EP_DIAG_WEBDAV:-}$(ep_get main diag_webdav '')" ] \
		|| [ -r "${EP_DIAG_CONF:-/etc/easyproxy/diag.conf}" ]; then
		diag_upload_webdav "$file"
		return $?
	fi
	id="$(diag_customer_id)"
	[ -n "$id" ] || id="unassigned"
	token_file="${EP_DIAG_TOKEN_FILE:-/etc/easyproxy/diag.token}"
	# Target is a private repository: a bundle carries the customer's host name,
	# its address table and its engine errors. Overridable per device.
	repo="${EP_DIAG_REPO:-$(ep_get main diag_repo bnm188/EasyProxy-Diag)}"
	branch="${EP_DIAG_BRANCH:-$(ep_get main diag_branch main)}"

	if [ ! -r "$token_file" ]; then
		echo "diag: no token at $token_file" >&2
		echo "diag: create one with Contents:write on $repo and save it: chmod 600 $token_file" >&2
		return 3
	fi
	token="$(tr -d ' \r\n' < "$token_file")"
	[ -n "$token" ] || { echo "diag: token file is empty" >&2; return 3; }

	if ! wget -q --spider -T 10 https://api.github.com 2>/dev/null; then
		echo "diag: api.github.com is unreachable from this router; bundle kept locally: $file" >&2
		return 4
	fi

	name="diagnostics/${id}/$(date -u '+%Y%m%dT%H%M%SZ')-$(uname -n 2>/dev/null | tr -c 'A-Za-z0-9_.-' '_').txt"
	api="https://api.github.com/repos/$repo/contents/$name"
	tmp="$(mktemp 2>/dev/null || echo /tmp/easyproxy-diag.json)"
	payload="$(printf '{"message":"diag %s","branch":"%s","content":"%s"}' \
		"$(uname -n 2>/dev/null || printf router)" "$branch" \
		"$(base64 "$file" 2>/dev/null | tr -d '\n')")"
	printf '%s' "$payload" > "$tmp"

	if command -v curl >/dev/null 2>&1; then
		rc="$(curl -s -o /dev/null -w '%{http_code}' -X PUT \
			-H "Authorization: token $token" \
			-H 'Accept: application/vnd.github+json' \
			-H 'Content-Type: application/json' \
			--data-binary @"$tmp" "$api" 2>/dev/null)"
	else
		rc="$(wget -q -O - --method=PUT \
			--header="Authorization: token $token" \
			--header='Accept: application/vnd.github+json' \
			--header='Content-Type: application/json' \
			--body-file="$tmp" "$api" 2>&1 >/dev/null && printf '201' || printf '000')"
	fi
	rm -f "$tmp"

	case "$rc" in
		200|201)
			echo "diag: uploaded $(basename "$name")"
			echo "raw: https://raw.githubusercontent.com/$repo/$branch/$name"
			return 0 ;;
		401|403)
			echo "diag: GitHub rejected the token (HTTP $rc); bundle kept locally: $file" >&2
			return 5 ;;
		*)
			echo "diag: upload failed (HTTP $rc); bundle kept locally: $file" >&2
			return 4 ;;
	esac
}

cmd_diag() {
	local upload path rc auto bytes
	upload=0
	auto=0
	case "$SUB" in
		--set-id|set-id|id)
			[ -n "$SUB2" ] || { echo "diag: --set-id needs a number, e.g. 001" >&2; return 2; }
			diag_set_id "$SUB2"; return $? ;;
		--daily|daily)
			diag_daily "$SUB2"; return $? ;;
		--upload) upload=1 ;;
		--auto) upload=1; auto=1 ;;
		"") ;;
		*) echo "Unknown diag option: $SUB" >&2; return 2 ;;
	esac
	path="${EP_DIAG_OUT:-/tmp/easyproxy-diag-$(date -u '+%Y%m%dT%H%M%SZ').txt}"
	diag_collect "$path" >/dev/null 2>&1
	bytes="$(wc -c < "$path" 2>/dev/null | tr -d ' ')"
	if [ "$JSON" = "1" ]; then
		if [ "$upload" = 1 ]; then
			if diag_upload "$path" >/dev/null 2>&1; then up=true; else up=false; fi
			printf '{"ok":%s,"path":"%s","bytes":%s,"uploaded":%s}\n' \
				"$up" "$(ep_json_escape "$path")" "${bytes:-0}" "$up"
			[ "$up" = "true" ] && return 0
			return 1
		fi
		printf '{"ok":true,"path":"%s","bytes":%s,"uploaded":false}\n' \
			"$(ep_json_escape "$path")" "${bytes:-0}"
		return 0
	fi
	[ "$auto" = 1 ] || echo "diagnostic bundle: $path (${bytes:-0} bytes)"
	if [ "$upload" = 1 ]; then
		diag_upload "$path" || return $?
		return 0
	fi
	echo "upload skipped: pass --upload to send it to GitHub (token in /etc/easyproxy/diag.token)"
	return 0
}

# --- self update -------------------------------------------------------------
# The panel can pull a newer release and install it without SSH. Three things
# make that safe enough to expose to a customer: the download is verified
# against SHA256SUMS before anything is replaced, the current program is
# archived first, and /etc/config/easyproxy plus /etc/easyproxy/* are never
# touched - an update cannot wipe a customer's nodes or their numbers.
EP_UPDATE_REPO="${EP_UPDATE_REPO:-}"
EP_UPDATE_BACKUP_DIR="${EP_UPDATE_BACKUP_DIR:-/etc/easyproxy/backups}"
EP_UPDATE_MIRRORS="${EP_UPDATE_MIRRORS:-}"
# Overridable so the regression suite can point the whole flow at a sandbox root.
EP_UPDATE_ROOT="${EP_UPDATE_ROOT:-/}"
EP_UPDATE_APP_JS="${EP_UPDATE_APP_JS:-/www/luci-static/resources/easyproxy/app.js}"
EP_UPDATE_MENU_JSON="${EP_UPDATE_MENU_JSON:-/usr/share/luci/menu.d/luci-app-easyproxy.json}"

update_repo() {
	[ -n "$EP_UPDATE_REPO" ] && { printf '%s' "$EP_UPDATE_REPO"; return 0; }
	ep_get main update_repo bnm188/EasyProxy
}

# Mirrors are a prefix, the way ghproxy works: <prefix>https://github.com/...
update_mirrors() {
	local list
	[ -n "$EP_UPDATE_MIRRORS" ] && { printf '%s' "$EP_UPDATE_MIRRORS"; return 0; }
	list="$(ep_get main update_mirror '')"
	[ -n "$list" ] || list="https://ghproxy.net/,https://ghfast.top/"
	printf '%s' "$list"
}

# Fetch with the mirror list as fallback: a router behind a polluted DNS still
# has a chance of getting the archive through a proxy prefix.
update_fetch() {
	local url out m original
	url="$1"; out="$2"
	if wget -q -T 30 -O "$out" "$url" 2>/dev/null && [ -s "$out" ]; then
		return 0
	fi
	original="$url"
	for m in $(printf '%s' "$(update_mirrors)" | tr ',' ' '); do
		[ -n "$m" ] || continue
		if wget -q -T 30 -O "$out" "${m}${original}" 2>/dev/null && [ -s "$out" ]; then
			echo "update: fetched through mirror $m" >&2
			return 0
		fi
	done
	rm -f "$out" 2>/dev/null
	return 1
}

ver_cmp() {
	awk -v a="${1#v}" -v b="${2#v}" 'BEGIN{
		split(a,x,"."); split(b,y,".")
		n=(length(x)>length(y)?length(x):length(y))
		for(i=1;i<=n;i++){p=x[i]+0;q=y[i]+0;if(p>q){print 1;exit}if(p<q){print -1;exit}}
		print 0
	}'
}

# The latest version is read from the release atom feed on github.com first.
# That feed is an ordinary page on github.com, so it is not subject to the
# api.github.com quota (60 unauthenticated requests per hour, counted per IP) -
# a router behind carrier NAT shares that budget with every neighbour and can
# find it exhausted without any activity of its own. The API stays as a fallback
# for the day the feed stops being served.
update_latest_version() {
	local repo tmp tag
	repo="$(update_repo)"
	tmp="$(mktemp 2>/dev/null || echo /tmp/easyproxy-rel.atom)"
	if update_fetch "https://github.com/$repo/releases.atom" "$tmp"; then
		# First entry in the feed is the newest release; the feed-level <id>
		# does not match this pattern, so it cannot be mistaken for a tag.
		tag="$(sed -n 's#.*Repository/[0-9][0-9]*/\(v[0-9][0-9.]*\).*#\1#p' "$tmp" | head -n 1)"
	fi
	rm -f "$tmp" 2>/dev/null
	if [ -z "${tag:-}" ]; then
		tag="$(update_latest_version_api)" || return 1
	fi
	[ -n "${tag:-}" ] || return 1
	printf '%s' "${tag#v}"
}

update_latest_version_api() {
	local repo tmp tag
	repo="$(update_repo)"
	tmp="$(mktemp 2>/dev/null || echo /tmp/easyproxy-rel.json)"
	if update_fetch "https://api.github.com/repos/$repo/releases/latest" "$tmp"; then
		tag="$(sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$tmp" | head -n 1)"
	fi
	rm -f "$tmp" 2>/dev/null
	[ -n "${tag:-}" ] || return 1
	printf '%s' "$tag"
}

update_current_version() { printf '%s' "$EP_VERSION"; }

cmd_update_check() {
	local latest cur json
	cur="$(update_current_version)"
	latest="$(update_latest_version)" || {
		echo "update: cannot reach the release API (api.github.com); check network or dns" >&2
		return 4
	}
	if [ "${1:-}" = "--json" ]; then
		if [ "$(ver_cmp "$latest" "$cur")" = "1" ]; then
			printf '{"current":"%s","latest":"%s","available":true,"repo":"%s"}\n' "$cur" "$latest" "$(update_repo)"
		else
			printf '{"current":"%s","latest":"%s","available":false,"repo":"%s"}\n' "$cur" "$latest" "$(update_repo)"
		fi
		return 0
	fi
	echo "current: $cur"
	echo "latest:  $latest"
	if [ "$(ver_cmp "$latest" "$cur")" = "1" ]; then
		echo "an update is available: easyproxy update apply"
		return 0
	fi
	echo "already up to date"
	return 0
}

update_backup() {
	local cur dir
	cur="$(update_current_version)"
	dir="$EP_UPDATE_BACKUP_DIR"
	mkdir -p "$dir" 2>/dev/null || { echo "update: cannot create $dir" >&2; return 1; }
	EP_UPDATE_ARCHIVE="$dir/rollback-$cur.tar.gz"
	# Only paths that exist are archived: a tree without the view directory is
	# not a reason to refuse the upgrade.
	set -- usr/sbin/easyproxy usr/lib/easyproxy usr/share/luci/menu.d/luci-app-easyproxy.json \
		usr/share/rpcd/acl.d/luci-app-easyproxy.json \
		www/luci-static/resources/easyproxy www/luci-static/resources/view/easyproxy
	existing=""
	for p in "$@"; do
		[ -e "$EP_UPDATE_ROOT/$p" ] && existing="$existing $p"
	done
	[ -n "$existing" ] || { echo "update: nothing to archive at $EP_UPDATE_ROOT" >&2; return 1; }
	# shellcheck disable=SC2086
	tar -czf "$EP_UPDATE_ARCHIVE" -C "$EP_UPDATE_ROOT" $existing 2>/dev/null || {
		echo "update: cannot archive the current program" >&2; return 1; }
	chmod 600 "$EP_UPDATE_ARCHIVE" 2>/dev/null || true
	echo "update: current $cur archived as $(basename "$EP_UPDATE_ARCHIVE")"
	return 0
}

# Panel files are plain JS: if a half-written file were served, LuCI would show
# the factory error instead of this page. Check the markers a real file has.
# Unpack a release payload (a whole rootfs tree, so it also carries the factory
# /etc/config/easyproxy) WITHOUT touching the user's config. Busybox tar has no
# --exclude; it only takes a pattern file via -X, and the patterns must carry the
# "./" prefix the archive members use ("*etc/config/*" silently matches nothing).
ep_extract_payload() {
	_ex="$(mktemp 2>/dev/null)" || _ex="/tmp/.ep_ex.$$"
	printf './etc/config/*\n' > "$_ex" 2>/dev/null
	tar -xzf "$1" -C "$2" -X "$_ex" 2>/dev/null
	_rc=$?
	rm -f "$_ex"
	return $_rc
}

update_verify_install() {
	local app menu v
	app="$EP_UPDATE_APP_JS"
	menu="$EP_UPDATE_MENU_JSON"
	[ -s "$app" ] || { echo "update: app.js is missing or empty" >&2; return 1; }
	grep -q 'baseclass.extend' "$app" || { echo "update: app.js is not the expected module" >&2; return 1; }
	grep -q 'easyproxy/update' "$menu" 2>/dev/null || true
	[ -x "$SELF" ] || { echo "update: CLI is not executable" >&2; return 1; }
	# Read the version baked into common.sh of the tree that was just installed.
	# Asking the running CLI would report the old build, which is exactly what
	# this check exists to catch. It must NOT read usr/sbin/easyproxy: that file
	# carries no EP_VERSION= of its own, so the `sed` expression below would
	# match its own source line and yield "\([^" as the version, failing every
	# real upgrade. (Found on a Kwrt x86_64 router: 0.8.7 -> 0.8.8 rolled back.)
	# The directory and the basename are written apart on purpose: the test
	# harness rewrites the absolute lib paths inside this script when it builds
	# its sandbox, and a single literal would be rewritten too, pointing the
	# check at a path that does not exist and failing every upgrade.
	v="$(sed -n 's/.*EP_VERSION="\([^"]*\)".*/\1/p' "$EP_UPDATE_ROOT/usr/lib/easyproxy"/common.sh 2>/dev/null | head -n 1)"
	case "$v" in
		''|*[!0-9.]*) v="" ;;
	esac
	[ -n "$v" ] || { echo "update: the installed CLI carries no version" >&2; return 1; }
	[ -z "${1:-}" ] || { [ "$v" = "$1" ] || { echo "update: installed $v, expected $1" >&2; return 1; }; }
	echo "update: installed version reports $v"
	return 0
}

update_restart_panel() {
	rm -f /tmp/luci-indexcache* 2>/dev/null
	[ -x /etc/init.d/rpcd ] || return 0
	/etc/init.d/rpcd stop >/dev/null 2>&1 || true
	sleep 2
	/etc/init.d/rpcd start >/dev/null 2>&1 || true
}

cmd_update_apply() {
	local repo ver cur tmp sums archive want got
	repo="$(update_repo)"
	ver="${1:-}"
	[ -n "$ver" ] || ver="$(update_latest_version)" || {
		echo "update: cannot reach the release API; nothing was changed" >&2; return 4; }
	ver="${ver#v}"
	cur="$(update_current_version)"
	if [ "$(ver_cmp "$ver" "$cur")" != "1" ]; then
		echo "update: $ver is not newer than $cur; nothing to do"
		return 0
	fi
	tmp="$(mktemp -d 2>/dev/null || echo /tmp/easyproxy-update)"
	mkdir -p "$tmp" 2>/dev/null
	sums="$tmp/SHA256SUMS"
	archive="$tmp/easyproxy-$ver-rootfs.tar.gz"
	base="https://github.com/$repo/releases/download/v$ver"
	echo "update: downloading $ver from $repo"
	update_fetch "$base/SHA256SUMS" "$sums" || { echo "update: cannot download SHA256SUMS; nothing was changed" >&2; rm -rf "$tmp"; return 4; }
	update_fetch "$base/easyproxy-$ver-rootfs.tar.gz" "$archive" || {
		echo "update: cannot download the archive; nothing was changed" >&2; rm -rf "$tmp"; return 4; }
	# Verify before touching a single file on the box.
	want="$(grep -F " easyproxy-$ver-rootfs.tar.gz" "$sums" 2>/dev/null | awk '{print $1}' | head -n 1)"
	[ -n "$want" ] || { echo "update: SHA256SUMS has no entry for this archive; refusing" >&2; rm -rf "$tmp"; return 5; }
	got="$(sha256sum "$archive" 2>/dev/null | awk '{print $1}')"
	[ "$got" = "$want" ] || {
		echo "update: checksum mismatch (want $want, got $got); refusing" >&2; rm -rf "$tmp"; return 5; }
	echo "update: checksum verified"

	update_backup || { rm -rf "$tmp"; return 1; }
	# The payload is a whole file tree, so it also carries the shipped default
	# /etc/config/easyproxy. Unpacking that over the user's own config silently
# wipes nodes, groups and the enabled flag (seen on a real router: a 0.8.9 ->
	# 0.8.10 upgrade left an empty node table). Config is the user's, never ours.
	if ! ep_extract_payload "$archive" "$EP_UPDATE_ROOT"; then
		echo "update: extraction failed; rolling back" >&2
		ep_extract_payload "$EP_UPDATE_ARCHIVE" "$EP_UPDATE_ROOT"
		update_restart_panel
		rm -rf "$tmp"
		return 6
	fi
	chmod 755 "$EP_UPDATE_ROOT/usr/sbin/easyproxy" "$EP_UPDATE_ROOT/etc/init.d/easyproxy" 2>/dev/null || true
	update_restart_panel
	if ! update_verify_install "$ver"; then
		echo "update: the new version did not verify; rolling back to $cur" >&2
		ep_extract_payload "$EP_UPDATE_ARCHIVE" "$EP_UPDATE_ROOT"
		chmod 755 "$EP_UPDATE_ROOT/usr/sbin/easyproxy" "$EP_UPDATE_ROOT/etc/init.d/easyproxy" 2>/dev/null || true
		update_restart_panel
		rm -rf "$tmp"
		return 6
	fi
	# One rollback archive is enough: the previous version is always the useful
	# one, and a growing pile of them would eat the customer's flash.
	for old in "$EP_UPDATE_BACKUP_DIR"/rollback-*.tar.gz; do
		[ -e "$old" ] || continue
		[ "$old" = "$EP_UPDATE_ARCHIVE" ] && continue
		rm -f "$old" 2>/dev/null || true
	done
	rm -rf "$tmp"
	echo "update: now running $ver (was $cur). Reload the page."
	echo "update: if anything looks wrong: easyproxy update rollback"
	return 0
}

cmd_update_rollback() {
	local last
	last="$(ls -1 "$EP_UPDATE_BACKUP_DIR"/rollback-*.tar.gz 2>/dev/null | tail -n 1)"
	[ -n "$last" ] || { echo "update: no rollback archive in $EP_UPDATE_BACKUP_DIR" >&2; return 3; }
	echo "update: restoring $(basename "$last")"
	ep_extract_payload "$last" "$EP_UPDATE_ROOT" || { echo "update: cannot extract $last" >&2; return 1; }
	chmod 755 "$EP_UPDATE_ROOT/usr/sbin/easyproxy" "$EP_UPDATE_ROOT/etc/init.d/easyproxy" 2>/dev/null || true
	update_restart_panel
	echo "update: rolled back; reload the page"
	return 0
}

update_backup_list() {
	local f
	for f in "$EP_UPDATE_BACKUP_DIR"/rollback-*.tar.gz; do
		[ -e "$f" ] || continue
		basename "$f"
	done
}

cmd_update() {
	case "${1:-}" in
		check|status)
			# --json is a global flag this CLI already parses ($JSON)
			if [ "${JSON:-0}" = "1" ]; then
				cmd_update_check --json
			else
				cmd_update_check
			fi
			;;
		apply|upgrade|install) cmd_update_apply "${2:-}" ;;
		rollback|back) cmd_update_rollback ;;
		backups|list) update_backup_list ;;
		*) echo "Unknown update action: ${1:-}" >&2; return 2 ;;
	esac
}

# --- panel entry points -------------------------------------------------------
# The panel's rpcd ACL grants exec on this CLI and nothing else, so the two
# helpers the panel needs are exposed as fixed verbs instead of `sh <script>`.
# Each verb validates its own arguments: a verb must never become an
# interpreter for arbitrary commands or an arbitrary URL fetcher.
cmd_traffic() {
	local iface="${1:-}"
	local lib="${EP_TRAFFIC_LIB:-/usr/lib/easyproxy/traffic.sh}"
	case "$iface" in
		"") ;;
		*[!A-Za-z0-9_.:-]*)
			echo "invalid interface name: refusing '${iface}'" >&2
			return 2
			;;
	esac
	[ -r "$lib" ] || { echo "traffic sampler is missing: $lib" >&2; return 3; }
	sh "$lib" "$iface"
}

# Remembered subscription: a subscription without its URL is useless the next
# day, and the URL is a credential (it often carries a token). It therefore
# lives in a 0600 file, never in UCI and never in the diagnostic bundle.
EP_SUB_CONF="${EP_SUB_CONF:-/etc/easyproxy/subscribe.conf}"
EP_SUB_CRON_TAG="# easyproxy-sub-daily"
EP_SUB_CRON="37 4 * * * /usr/sbin/easyproxy subscribe --update >/dev/null 2>&1 $EP_SUB_CRON_TAG"

sub_record() {
	local url="$1" prefix="$2"
	mkdir -p "$(dirname "$EP_SUB_CONF")" 2>/dev/null
	( umask 077; printf 'url=%s\nprefix=%s\n' "$url" "$prefix" > "$EP_SUB_CONF" ) || return 1
	chmod 600 "$EP_SUB_CONF" 2>/dev/null || true
	return 0
}

sub_daily() {
	local state="$1"
	case "$state" in
		on|enable|1)
			[ -r "$EP_SUB_CONF" ] || {
				echo "subscribe: no subscription remembered yet; run 'easyproxy subscribe <url>' first" >&2
				return 1; }
			mkdir -p "$(dirname "$EP_CRONTAB")" 2>/dev/null
			if [ -f "$EP_CRONTAB" ]; then
				grep -v 'easyproxy subscribe --update' "$EP_CRONTAB" > "$EP_CRONTAB.tmp" 2>/dev/null || true
				mv -f "$EP_CRONTAB.tmp" "$EP_CRONTAB"
			fi
			printf '%s\n' "$EP_SUB_CRON" >> "$EP_CRONTAB"
			chmod 600 "$EP_CRONTAB" 2>/dev/null || true
			/etc/init.d/cron enable >/dev/null 2>&1 || true
			/etc/init.d/cron restart >/dev/null 2>&1 || true
			echo "subscribe: daily update enabled (04:37)"
			return 0 ;;
		off|disable|0)
			[ -f "$EP_CRONTAB" ] || { echo "subscribe: no daily job configured"; return 0; }
			grep -v 'easyproxy subscribe --update' "$EP_CRONTAB" > "$EP_CRONTAB.tmp" 2>/dev/null || true
			mv -f "$EP_CRONTAB.tmp" "$EP_CRONTAB"
			/etc/init.d/cron restart >/dev/null 2>&1 || true
			echo "subscribe: daily update disabled"
			return 0 ;;
		*) echo "subscribe: --daily takes on or off" >&2; return 2 ;;
	esac
}

sub_update() {
	local url prefix
	[ -r "$EP_SUB_CONF" ] || {
		echo "subscribe: no subscription remembered yet; run 'easyproxy subscribe <url>' first" >&2
		return 1; }
	url="$(sed -n 's/^url=//p' "$EP_SUB_CONF" | head -n 1)"
	prefix="$(sed -n 's/^prefix=//p' "$EP_SUB_CONF" | head -n 1)"
	[ -n "$url" ] || { echo "subscribe: remembered subscription has no url" >&2; return 1; }
	cmd_subscribe "$url" "$prefix"
}

# Never print the subscription token: the URL is a credential, so JSON only
# carries the host and whether a subscription is remembered at all.
sub_status_json() {
	local url="" prefix="" host="" daily=0
	if [ -r "$EP_SUB_CONF" ]; then
		prefix="$(sed -n 's/^prefix=//p' "$EP_SUB_CONF" 2>/dev/null)"
		url="$(sed -n 's/^url=//p' "$EP_SUB_CONF" 2>/dev/null)"
		case "$url" in
			http://*|https://*)
				host="${url#*://}"
				host="${host%%/*}"
				host="${host%%\?*}"
				;;
		esac
	fi
	if crontab -l 2>/dev/null | grep -q 'easyproxy-sub-daily'; then
		daily=1
	fi
	printf '{"ok":true,"remembered":%s,"prefix":"%s","host":"%s","daily":%s}\n' \
		"$([ -n "$url" ] && printf true || printf false)" \
		"$(ep_json_escape "$prefix")" \
		"$(ep_json_escape "$host")" \
		"$daily"
}

cmd_subscribe() {
	local url="${1:-}"
	local prefix="${2:-}"
	local lib="${EP_SUBSCRIBE_LIB:-/usr/lib/easyproxy/subscribe.sh}"
	if [ "$JSON" = "1" ]; then
		case "$url" in
			"") sub_status_json; return 0 ;;
			--show|show) sub_status_json; return 0 ;;
			--update|update) JSON=1; sub_update; return $? ;;
			--forget)
				[ -f "$EP_SUB_CONF" ] && rm -f "$EP_SUB_CONF"
				printf '{"ok":true,"remembered":false,"cleared":true}\n'
				return 0 ;;
		esac
	fi
	case "$url" in
		--update|update) sub_update; return $? ;;
		--daily|daily) sub_daily "${prefix:-}"; return $? ;;
		--forget)
			[ -f "$EP_SUB_CONF" ] && rm -f "$EP_SUB_CONF"
			echo "subscribe: remembered subscription cleared"
			return 0 ;;
		--show)
			if [ -r "$EP_SUB_CONF" ]; then
				sed -n 's/^prefix=/prefix=/p' "$EP_SUB_CONF"
				sed -n 's/^url=//p' "$EP_SUB_CONF" | sed 's/^/url=/'
			else
				echo "subscribe: nothing remembered"
			fi
			return 0 ;;
	esac
	case "$url" in
		http://*|https://*) ;;
		*)
			echo "refusing subscription URL: only http:// and https:// are accepted" >&2
			return 2
			;;
	esac
	case "$prefix" in
		*[!A-Za-z0-9_.-]*)
			echo "invalid name prefix: refusing '${prefix}'" >&2
			return 2
			;;
	esac
	[ -r "$lib" ] || { echo "subscription helper is missing: $lib" >&2; return 3; }
	sh "$lib" "$url" "$prefix"
	rc=$?
	# Remember the URL whether or not every link imported: the endpoint list
	# changes over time and the next run only adds what is genuinely new.
	[ "$rc" -eq 0 ] && sub_record "$url" "$prefix"
	return $rc
}

CMD="${1:-}"
[ $# -gt 0 ] && shift

JSON=0
SUB=""
SUB2=""
SUB3=""
for arg in "$@"; do
	case "$arg" in
		--json) JSON=1 ;;
		*) if [ -z "$SUB" ]; then SUB="$arg"
		   elif [ -z "$SUB2" ]; then SUB2="$arg"
		   elif [ -z "$SUB3" ]; then SUB3="$arg"
		   fi ;;
	esac
done

case "$CMD" in
	status)
		if [ "$JSON" = "1" ]; then cmd_status_json; else cmd_status_text; fi
		;;
	version|--version|-v)
		# The panel's version button calls this; without it the button fell
		# through to the usage text and reported a non-zero exit.
		if [ "$JSON" = "1" ]; then
			printf '{"version":"%s"}\n' "$EP_VERSION"
		else
			printf '%s\n' "$EP_VERSION"
		fi
		;;
	validate)
		if [ "$JSON" = "1" ]; then cmd_validate_json; else cmd_validate_text; fi
		;;
	binary)
		cmd_binary "$SUB"
		;;
	engine)
		case "$SUB" in
			list) cmd_engine_list ;;
			health|check) cmd_engine_health ;;
			version) cmd_engine_version ;;
			status|"") cmd_engine ;;
			*) echo "Unknown engine action: $SUB" >&2; exit 2 ;;
		esac
		;;
	node)
		case "$SUB" in
			list|"") cmd_node_list ;;
			show) cmd_node_list ;;
			add) cmd_node_add "$SUB2" "$SUB3" ;;
			import) cmd_node_import "$SUB2" "$SUB3" ;;
			import-clash|clash-import) cmd_node_import_clash "$SUB2" ;;
			export|dump) cmd_node_export "$SUB2" ;;
			enable) cmd_node_enabled "$SUB2" 1 ;;
			disable) cmd_node_enabled "$SUB2" 0 ;;
			del|delete|rm) cmd_node_del "$SUB2" ;;
			test|ping) cmd_node_test ;;
			*) echo "Unknown node action: $SUB" >&2; exit 2 ;;
		esac
		;;
	group)
		case "$SUB" in
			list|"") cmd_group_list ;;
			use|set) cmd_group_use "$SUB2" "$SUB3" ;;
			*) echo "Unknown group action: $SUB" >&2; exit 2 ;;
		esac
		;;
	rule)
		case "$SUB" in
			list|"") cmd_rule_list ;;
			add) cmd_rule_add "$SUB2" ;;
			del|delete|rm) cmd_rule_del "$SUB2" ;;
			*) echo "Unknown rule action: $SUB" >&2; exit 2 ;;
		esac
		;;
	connections|conn)
		# --json is consumed by the argument loop above, not handed down as a
		# positional, so it has to be passed on explicitly here.
		if [ "$JSON" = "1" ]; then cmd_connections --json; else cmd_connections; fi
		;;
	config)
		case "$SUB" in
			generate|"") cmd_config_generate ;;
			backup) cmd_config_backup "$SUB2" ;;
			restore|import) cmd_config_restore "$SUB2" ;;
			reset|default) cmd_config_reset ;;
			*) echo "Unknown config action: $SUB" >&2; exit 2 ;;
		esac
		;;
	ruleset|rulesets)
		cmd_ruleset "$SUB"
		;;
	doctor) cmd_doctor ;;
	diag) cmd_diag ;;
	update|upgrade) cmd_update "$SUB" "$SUB2" ;;
	uninstall-clean|clean) cmd_uninstall_clean ;;
	start) cmd_start ;;
	bypass)
		cmd_bypass "$SUB" ;;
	transparent)
		case "$SUB" in
			apply) cmd_transparent apply ;;
			remove|down|off) cmd_transparent remove ;;
			status|"") cmd_transparent status ;;
			audit|check) cmd_transparent audit ;;
			*) echo "Unknown transparent action: $SUB" >&2; exit 2 ;;
		esac
		;;
	stop) cmd_stop ;;
	restart) cmd_restart ;;
	run) cmd_run ;;
	log) cmd_log "$SUB" ;;
	traffic) cmd_traffic "$SUB" ;;
	subscribe) cmd_subscribe "$SUB" "$SUB2" ;;
	help|-h|--help|"") usage ;;
	*) usage >&2; exit 2 ;;
esac

