#!/bin/sh

. /usr/lib/easyproxy/common.sh

PROG="easyproxy"

usage() {
	cat <<'EOF'
EasyProxy 0.1.0 — Stage 1
Usage:
  easyproxy status       Show current configuration status
  easyproxy validate     Validate safe configuration values
  easyproxy engine       Show selected engine and binary availability
  easyproxy start        Guarded start (not enabled until Stage 2)
  easyproxy stop         Stop placeholder (Stage 2 runtime required)
  easyproxy help         Show this help
EOF
}

cmd_status() {
	local enabled engine china
	enabled="$(ep_get main enabled 0)"
	engine="$(ep_get main engine none)"
	china="$(ep_get routing china_policy direct)"
	printf 'EasyProxy: Stage 1 scaffold\n'
	printf 'Enabled: %s\n' "$enabled"
	printf 'Engine: %s\n' "$engine"
	printf 'China policy: %s\n' "$china"
	printf 'Runtime: not implemented in Stage 1\n'
}

cmd_validate() {
	local enabled engine china fail_closed
	enabled="$(ep_get main enabled 0)"
	engine="$(ep_get main engine none)"
	china="$(ep_get routing china_policy direct)"
	fail_closed="$(ep_get routing fail_closed 1)"

	case "$enabled" in 0|1) ;; *) echo "Invalid main.enabled: expected 0 or 1" >&2; return 1 ;; esac
	ep_valid_engine "$engine" || { echo "Invalid main.engine: $engine" >&2; return 1; }
	[ "$china" = "direct" ] || { echo "Unsafe china_policy: Stage 1 only accepts direct" >&2; return 1; }
	case "$fail_closed" in 0|1) ;; *) echo "Invalid routing.fail_closed: expected 0 or 1" >&2; return 1 ;; esac

	echo "Configuration values are valid."
	echo "Safety check: China policy is DIRECT."
	echo "Note: this validates UCI values only; no routing is active in Stage 1."
}

cmd_engine() {
	local engine binary
	engine="$(ep_get main engine none)"
	echo "Selected engine: $engine"
	case "$engine" in
		dae) binary="$(ep_get dae binary /usr/bin/dae)" ;;
		sing-box) binary="$(ep_get sing_box binary /usr/bin/sing-box)" ;;
		none) echo "No engine selected."; return 0 ;;
		*) echo "Invalid engine selection." >&2; return 1 ;;
	esac
	if [ -x "$binary" ]; then
		echo "Binary: available ($binary)"
	else
		echo "Binary: missing ($binary)"
	fi
}

cmd_start() {
	local enabled engine
	enabled="$(ep_get main enabled 0)"
	engine="$(ep_get main engine none)"
	[ "$enabled" = "1" ] || { echo "EasyProxy is disabled. Set easyproxy.main.enabled=1 to enable." >&2; return 1; }
	[ "$engine" != "none" ] || { echo "No proxy engine selected." >&2; return 1; }
	echo "Start blocked: Stage 2 runtime adapters are not implemented."
	echo "No firewall, DNS or route changes were made."
	return 2
}

cmd_stop() {
	echo "No EasyProxy proxy process is managed in Stage 1."
	return 0
}

case "$1" in
	status) cmd_status ;;
	validate) cmd_validate ;;
	engine) cmd_engine ;;
	start) cmd_start ;;
	stop) cmd_stop ;;
	help|-h|--help|"") usage ;;
	*) usage >&2; exit 2 ;;
esac
